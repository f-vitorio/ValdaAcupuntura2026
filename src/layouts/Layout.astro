---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
    heroPreloadUrl?: string;
	canonicalUrl?: string;
	ogImage?: string;
}

const { title, description, heroPreloadUrl, canonicalUrl, ogImage } = Astro.props;
const ogImageUrl = ogImage || 'https://valdaacupuntura.com.br/og-default.jpg';
const currentCanonical = canonicalUrl || 'https://valdaacupuntura.com.br/';

// Generate BreadcrumbList based on URL
const urlPath = Astro.url.pathname;
const breadcrumbs = [
  { name: 'Início', url: 'https://valdaacupuntura.com.br/' }
];

if (urlPath.includes('/tratamentos/')) {
  breadcrumbs.push({ name: 'Tratamentos', url: 'https://valdaacupuntura.com.br/acupuntura-sao-paulo-tratamentos/' });
  const treatmentName = urlPath.split('/tratamentos/')[1]?.replace(/\/$/, '')?.replace(/-/g, ' ');
  if (treatmentName) {
    breadcrumbs.push({ name: treatmentName.charAt(0).toUpperCase() + treatmentName.slice(1), url: currentCanonical });
  }
} else if (urlPath.includes('/precos')) {
  breadcrumbs.push({ name: 'Preços', url: currentCanonical });
} else if (urlPath.includes('/sobre-dra-valda')) {
  breadcrumbs.push({ name: 'Sobre Dra. Valda', url: currentCanonical });
} else if (urlPath.includes('/acupuntura-sao-paulo-tratamentos')) {
  breadcrumbs.push({ name: 'Tratamentos', url: currentCanonical });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": item.url
  }))
};
---


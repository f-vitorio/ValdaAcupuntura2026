	<!-- Rastreamento de cliques no WhatsApp -->
	<script>
		document.addEventListener('DOMContentLoaded', function() {
			// Rastrear cliques nos CTAs principais
			document.querySelectorAll('.wa-cta').forEach(function(cta) {
				cta.addEventListener('click', function() {
					var position = this.getAttribute('data-cta-position') || 'unknown';
					if (typeof gtag === 'function') {
						gtag('event', 'whatsapp_click', {
							page_location: window.location.href,
							cta_position: position
						});
					}
				});
			});

			// Rastrear clique no botão flutuante do WhatsApp
			var floatingBtn = document.querySelector('a[href*="wa.me"][class*="fixed"]');
			if (floatingBtn) {
				floatingBtn.addEventListener('click', function() {
					if (typeof gtag === 'function') {
						gtag('event', 'whatsapp_float_click', {
							page_location: window.location.href
						});
					}
				});
			}

			// Rastrear clique nos botões de ligação
			document.querySelectorAll('.phone-cta').forEach(function(phoneBtn) {
				phoneBtn.addEventListener('click', function() {
					var position = this.getAttribute('data-cta-position') || 'phone-unknown';
					if (typeof gtag === 'function') {
						gtag('event', 'phone_click', {
							page_location: window.location.href,
							cta_position: position
						});
					}
				});
			});
		});
	</script>

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { getImage } from 'astro:assets';
import heroImgSource from '../assets/hero-premium.webp';

const heroImgOptimized = await getImage({
	src: heroImgSource,
	format: 'avif',
	width: 800,
});

const waAvaliacaoInicial =
	'https://wa.me/5511983134656?text=Ol%C3%A1!%20Vi%20os%20pre%C3%A7os%20no%20site%20e%20gostaria%20de%20agendar%20minha%20avalia%C3%A7%C3%A3o%20inicial%20de%20R%24%20250.';
const waAcompanhamento =
	'https://wa.me/5511983134656?text=Ol%C3%A1!%20Vi%20os%20pre%C3%A7os%20no%20site%20e%20gostaria%20de%20agendar%20sess%C3%B5es%20de%20acompanhamento.';

const faqItems = [
	{
		question: 'Quanto custa uma sessão de acupuntura?',
		answer:
			'A avaliação inicial de acupuntura custa R$ 250. Para continuidade do acompanhamento, há opções de 4 sessões por R$ 700 ou 10 sessões por R$ 1.500.'
	},
	{
		question: 'Quanto custa acupuntura em São Paulo?',
		answer:
			'Na Valda Acupuntura, em São Paulo (Vila da Saúde, Zona Sul), a avaliação inicial custa R$ 250 e a continuidade pode ser feita em opções de 4 sessões por R$ 700 ou 10 sessões por R$ 1.500.'
	},
	{
		question: 'Qual o valor de uma sessão de acupuntura?',
		answer:
			'O valor depende da modalidade de atendimento. A avaliação inicial custa R$ 250. Na continuidade, o valor por sessão é de R$ 175 no pacote de 4 sessões (R$ 700) ou R$ 150 no pacote de 10 sessões (R$ 1.500).'
	},
	{
		question: 'A avaliação inicial tem valor diferente da sessão?',
		answer:
			'Sim. A avaliação inicial custa R$ 250 e é o primeiro passo para entender o caso e definir a modalidade de acompanhamento. As opções de continuidade são de 4 sessões por R$ 700 ou 10 sessões por R$ 1.500.'
	},
	{
		question: 'Vocês trabalham com pacote de sessões?',
		answer:
			'Sim. Trabalhamos com pacotes de 4 sessões por R$ 700 e de 10 sessões por R$ 1.500 para a continuidade do acompanhamento.'
	},
	{
		question: 'Onde fica a clínica de acupuntura?',
		answer:
			'A clínica fica na R. Maquerobi, 156 - Vila da Saúde, São Paulo - SP, na Zona Sul, a poucos minutos de caminhada do Metrô Praça da Árvore.'
	},
	{
		question: 'Como faço para agendar?',
		answer:
			'O agendamento é feito pelo WhatsApp: (11) 98313-4656. Basta enviar uma mensagem informando sua principal necessidade para reservar sua avaliação inicial.'
	}
];
---

<Layout
	title="Acupuntura: Preço da Sessão em São Paulo | Valda Acupuntura"
	description="Quanto custa uma sessão de acupuntura em São Paulo? Veja os valores da avaliação e das opções de acompanhamento na Valda Acupuntura."
	canonicalUrl="https://valdaacupuntura.com.br/precos/"
	heroPreloadUrl={heroImgOptimized.src}>

	<!-- Service Schema com preço -->
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Service",
		"name": "Avaliação Inicial de Acupuntura",
		"description": "Avaliação individual de acupuntura para compreender o caso e definir a melhor modalidade de acompanhamento.",
		"provider": {
			"@type": "MedicalBusiness",
			"@id": "https://valdaacupuntura.com.br/#organization",
			"name": "Valda Acupuntura"
		},
		"areaServed": {
			"@type": "City",
			"name": "São Paulo"
		},
		"offers": {
			"@type": "Offer",
			"price": "250",
			"priceCurrency": "BRL",
			"availability": "https://schema.org/InStock",
			"url": "https://valdaacupuntura.com.br/precos/"
		}
	})} />

	<!-- FAQ JSON-LD Schema (perguntas visíveis na página) -->
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"mainEntity": faqItems.map(item => ({
			"@type": "Question",
			"name": item.question,
			"acceptedAnswer": {
				"@type": "Answer",
				"text": item.answer
			}
		}))
	})} />

	<main>
		<Header />

		<!-- HERO -->
		<section class="relative py-20 md:py-32 text-center overflow-hidden">
			<img
				src={heroImgOptimized.src}
				alt="Clínica de acupuntura em São Paulo, na Vila da Saúde"
				class="absolute inset-0 w-full h-full object-cover object-center z-0"
				fetchpriority="high"
				loading="eager"
				decoding="async"
				width={1920}
				height={1080}
			/>
			<div class="absolute inset-0 bg-gradient-to-b from-[#e8f5e9]/95 to-white/90 z-0"></div>

			<div class="container mx-auto px-4 max-w-4xl relative z-10">
				<span class="inline-block bg-[#e6fffa] text-[#047857] px-4 py-2 rounded-full font-semibold text-sm mb-6 border border-[#b7eb8f] shadow-sm">
					Valda Acupuntura • Vila da Saúde, São Paulo
				</span>
				
				<!-- Prova Social - Acima da Dobra -->
				<div class="flex flex-wrap items-center justify-center gap-3 mb-6 text-sm text-gray-600">
					<span class="inline-flex items-center gap-1.5 bg-white/80 px-4 py-2 rounded-full border border-gray-200 shadow-sm">
						<span class="text-yellow-500">⭐</span>
						<span class="font-bold text-gray-800">4,9</span>
						<span>no Google</span>
					</span>
					<span class="inline-flex items-center gap-1.5 bg-white/80 px-4 py-2 rounded-full border border-gray-200 shadow-sm">
						<span class="text-primary">✓</span>
						<span class="font-bold text-gray-800">20 anos</span>
						<span>de experiência</span>
					</span>
					<span class="inline-flex items-center gap-1.5 bg-white/80 px-4 py-2 rounded-full border border-gray-200 shadow-sm">
						<span class="text-primary">✓</span>
						<span>Atendimento individual</span>
					</span>
				</div>

				<h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-primary leading-tight mb-6 font-bold">
					Quanto custa uma sessão de acupuntura em São Paulo?
				</h1>
				<p class="text-xl text-gray-700 mb-4 max-w-3xl mx-auto leading-relaxed">
					Confira os valores da avaliação inicial e das opções de acompanhamento em acupuntura. Na Valda Acupuntura, o atendimento começa com uma avaliação individual para compreender cada caso.
				</p>
				
			<!-- Urgência acima do CTA -->
			<p class="text-base text-secondary font-semibold mb-6">
				📍 Restam poucas vagas esta semana — agende sua avaliação
			</p>
				
			<div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
				<a
					href={waAvaliacaoInicial}
					target="_blank"
					rel="noopener"
					data-cta-position="hero"
					class="wa-cta inline-flex items-center justify-center gap-3 bg-secondary text-white px-8 py-4 rounded-full font-bold text-lg shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all w-full sm:w-auto">
					AGENDAR MINHA AVALIAÇÃO · R$ 250
				</a>
				<a
					href="tel:+5511983134656"
					data-cta-position="hero-phone"
					class="phone-cta inline-flex items-center justify-center gap-3 bg-white text-primary border-2 border-primary px-8 py-4 rounded-full font-bold text-lg shadow-md hover:bg-primary hover:text-white transition-all w-full sm:w-auto">
					📞 Ligar Agora · (11) 98313-4656
				</a>
			</div>
			</div>
		</section>

		<!-- RESPOSTA IMEDIATA + PREÇOS -->
		<section id="precos" class="py-16 md:py-24 bg-white scroll-mt-24">
			<div class="container mx-auto px-4 max-w-6xl">
				<div class="text-center max-w-3xl mx-auto mb-12">
					<h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-4">Preço da acupuntura</h2>
					<p class="text-xl text-gray-700 leading-relaxed font-medium">
						A avaliação inicial de acupuntura custa <strong class="text-primary">R$ 250</strong>. Para continuidade do acompanhamento, há opções de <strong class="text-primary">4 sessões por R$ 700</strong> ou <strong class="text-primary">10 sessões por R$ 1.500</strong>.
					</p>
				</div>

				<div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
					<!-- Avaliação Inicial -->
					<div class="bg-primary p-8 rounded-2xl shadow-xl border border-primary relative flex flex-col text-center transform md:-translate-y-4">
						<div class="absolute top-0 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-secondary text-white px-5 py-1.5 rounded-full text-sm font-bold shadow-sm whitespace-nowrap">Passo Inicial</div>
						<h3 class="font-serif text-2xl font-bold text-white mb-2 mt-2">Avaliação Inicial</h3>
						<p class="text-white/80 mb-6 font-medium">Entendimento do seu caso</p>
						<div class="text-4xl font-bold text-white mb-6">R$ 250</div>
					<a
						href={waAvaliacaoInicial}
						target="_blank"
						rel="noopener"
						data-cta-position="precos-avaliacao"
						class="wa-cta mt-auto inline-block text-secondary font-bold hover:underline transition-colors">
						Agendar pelo WhatsApp →
					</a>
					</div>

					<!-- 4 sessões -->
					<div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col text-center hover:border-gray-200 transition-colors">
						<h3 class="font-serif text-2xl font-bold text-gray-800 mb-2">4 sessões</h3>
						<p class="text-gray-500 mb-2 font-medium">Opção de continuidade</p>
						<p class="text-gray-400 text-sm mb-2">R$ 175 por sessão</p>
						<div class="text-4xl font-bold text-primary mb-6">R$ 700</div>
					<a
						href={waAcompanhamento}
						target="_blank"
						rel="noopener"
						data-cta-position="precos-4sessoes"
						class="wa-cta mt-auto inline-block text-secondary font-bold hover:underline transition-colors">
						Agendar pelo WhatsApp →
					</a>
					</div>

					<!-- 10 sessões -->
					<div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col text-center hover:border-gray-200 transition-colors">
						<h3 class="font-serif text-2xl font-bold text-gray-800 mb-2">10 sessões</h3>
						<p class="text-gray-500 mb-2 font-medium">Melhor valor em continuidade</p>
						<p class="text-gray-400 text-sm mb-2">R$ 150 por sessão</p>
						<div class="text-4xl font-bold text-primary mb-6">R$ 1.500</div>
					<a
						href={waAcompanhamento}
						target="_blank"
						rel="noopener"
						data-cta-position="precos-10sessoes"
						class="wa-cta mt-auto inline-block text-secondary font-bold hover:underline transition-colors">
						Agendar pelo WhatsApp →
					</a>
					</div>
				</div>
			</div>

			<!-- Garantia de satisfação -->
			<div class="max-w-3xl mx-auto mt-10 text-center">
				<div class="inline-flex items-center gap-3 bg-green-50 text-green-800 px-6 py-4 rounded-xl border border-green-200 shadow-sm">
					<span class="text-green-600 text-xl">✓</span>
					<p class="text-sm md:text-base font-medium">
						<strong>Avaliação transparente:</strong> você sai da sessão sabendo exatamente o que esperar do tratamento, sem surpresas.
					</p>
				</div>
			</div>
		</section>

		<!-- DEPOIMENTOS -->
		<section class="py-16 md:py-20 bg-bg-light">
			<div class="container mx-auto px-4 max-w-4xl">
				<div class="text-center mb-10">
					<h2 class="font-serif text-2xl md:text-3xl text-primary font-bold mb-2">O que dizem nossas pacientes</h2>
					<p class="text-gray-600">Depoimentos reais de quem já passou pela avaliação</p>
				</div>
				<div class="grid md:grid-cols-3 gap-6">
					<div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 text-center">
						<div class="text-yellow-500 text-lg mb-3">⭐⭐⭐⭐⭐</div>
						<p class="text-gray-700 italic mb-4">"Avaliação completa e muito atenciosa. Já agendei meu pacote de 4 sessões."</p>
						<p class="font-bold text-primary text-sm">Priscila Souza</p>
					</div>
					<div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 text-center">
						<div class="text-yellow-500 text-lg mb-3">⭐⭐⭐⭐⭐</div>
						<p class="text-gray-700 italic mb-4">"Profissional nota 10. Preço justo e resultado desde a primeira sessão."</p>
						<p class="font-bold text-primary text-sm">Giselle Florencio</p>
					</div>
					<div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 text-center">
						<div class="text-yellow-500 text-lg mb-3">⭐⭐⭐⭐⭐</div>
						<p class="text-gray-700 italic mb-4">"Atendimento impecável. Recomendo para quem busca qualidade e seriedade."</p>
						<p class="font-bold text-primary text-sm">Tayssa Silva</p>
					</div>
				</div>
			</div>
		</section>

		<!-- QUANTO CUSTA UMA SESSÃO -->
		<section class="py-16 md:py-20 bg-bg-light">
			<div class="container mx-auto px-4 max-w-3xl text-center">
				<h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-6">Quanto custa uma sessão de acupuntura?</h2>
				<p class="text-xl text-gray-700 leading-relaxed mb-4">
					O valor da acupuntura depende da modalidade de atendimento. Na Valda Acupuntura, a avaliação inicial custa <strong class="text-primary">R$ 250</strong>. Para continuidade, existem opções de <strong class="text-primary">4 sessões por R$ 700</strong> e <strong class="text-primary">10 sessões por R$ 1.500</strong>.
				</p>
				<p class="text-lg text-gray-600 leading-relaxed">
					Assim, você conhece o preço da sessão de acupuntura antes de agendar, com valores transparentes e sem surpresas. O primeiro passo é sempre a avaliação, para que a melhor opção de acompanhamento seja definida para o seu caso.
				</p>
			</div>
		</section>

		<!-- COMO FUNCIONA O ATENDIMENTO -->
		<section class="py-16 md:py-24 bg-white">
			<div class="container mx-auto px-4 max-w-4xl">
				<div class="text-center mb-12">
					<h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-4">Como funciona o atendimento de acupuntura?</h2>
					<p class="text-lg text-gray-600 leading-relaxed">
						Do primeiro contato ao acompanhamento, cada etapa é pensada para compreender o seu caso e conduzir o tratamento de acupuntura da forma mais adequada.
					</p>
				</div>

				<div class="grid md:grid-cols-5 gap-8 text-center relative">
					<div class="hidden md:block absolute top-8 left-[10%] right-[10%] h-0.5 bg-gray-200 z-0"></div>
					<div class="relative">
						<div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4 relative z-10 shadow-lg border-4 border-white">1</div>
						<h3 class="font-bold text-xl text-gray-800 mb-2">Avaliação inicial</h3>
						<p class="text-gray-600 text-sm">O primeiro passo para compreender o seu caso.</p>
					</div>
					<div class="relative">
						<div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4 relative z-10 shadow-lg border-4 border-white">2</div>
						<h3 class="font-bold text-xl text-gray-800 mb-2">Entendimento individual</h3>
						<p class="text-gray-600 text-sm">A acupunturista escuta seu relato e seu histórico.</p>
					</div>
					<div class="relative">
						<div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4 relative z-10 shadow-lg border-4 border-white">3</div>
						<h3 class="font-bold text-xl text-gray-800 mb-2">Definição da abordagem</h3>
						<p class="text-gray-600 text-sm">A forma de atendimento mais adequada ao seu caso.</p>
					</div>
					<div class="relative">
						<div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4 relative z-10 shadow-lg border-4 border-white">4</div>
						<h3 class="font-bold text-xl text-gray-800 mb-2">Sessões de acompanhamento</h3>
						<p class="text-gray-600 text-sm">Sessões individuais, conforme a abordagem definida.</p>
					</div>
					<div class="relative">
						<div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4 relative z-10 shadow-lg border-4 border-white">5</div>
						<h3 class="font-bold text-xl text-gray-800 mb-2">Acompanhamento da evolução</h3>
						<p class="text-gray-600 text-sm">A evolução é acompanhada a cada sessão.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ACUPUNTURA EM SÃO PAULO -->
		<section class="py-16 md:py-24 bg-primary text-white">
			<div class="container mx-auto px-4 max-w-4xl text-center">
				<h2 class="font-serif text-3xl md:text-4xl font-bold mb-6">Acupuntura em São Paulo</h2>
				<p class="text-lg text-white/90 leading-relaxed mb-6">
					A clínica de acupuntura Valda Acupuntura realiza atendimento presencial na <strong class="text-white font-bold">R. Maquerobi, 156 - Vila da Saúde</strong>, na <strong class="text-white font-bold">Zona Sul de São Paulo</strong>, a poucos minutos de caminhada do <strong class="text-white font-bold">Metrô Praça da Árvore</strong> (Linha 1 - Azul). As sessões são individuais, em ambiente tranquilo, com facilidade de acesso para quem mora na região ou vem de outros bairros da Zona Sul.
				</p>
				<div class="inline-block p-6 bg-white/10 rounded-2xl border border-white/20 backdrop-blur-sm mb-8">
					<p class="text-xl font-bold">📍 R. Maquerobi, 156 - Vila da Saúde, São Paulo - SP</p>
					<p class="opacity-80">Zona Sul • Próximo ao Metrô Praça da Árvore</p>
				</div>
				<div class="flex flex-wrap items-center justify-center gap-4">
					<a
						href="/#localizacao"
						class="inline-flex items-center justify-center gap-2 bg-white text-primary px-6 py-3 rounded-full font-bold hover:bg-gray-100 transition-colors shadow-md">
						Veja onde fica a clínica
					</a>
					<a
						href="/acupuntura-sao-paulo-tratamentos/"
						class="inline-flex items-center justify-center gap-2 bg-white/10 text-white border border-white/30 px-6 py-3 rounded-full font-bold hover:bg-white/20 transition-colors">
						Conheça os tratamentos de acupuntura
					</a>
				</div>
			</div>
		</section>

		<!-- POR QUE COMEÇAR PELA AVALIAÇÃO? -->
		<section class="py-16 md:py-24 bg-white">
			<div class="container mx-auto px-4 max-w-4xl">
				<div class="text-center max-w-3xl mx-auto mb-12">
					<h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-4">Por que começar pela avaliação?</h2>
					<p class="text-lg text-gray-600 leading-relaxed">
						Antes de definir qualquer modalidade de acompanhamento, o primeiro passo é compreender o seu caso. Na avaliação inicial, a acupunturista escuta o seu relato, entende seu histórico e orienta a melhor forma de conduzir o seu atendimento.
					</p>
				</div>
				<div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto text-left">
					<div class="flex gap-4 items-start bg-bg-light p-6 rounded-xl border border-gray-100">
						<span class="text-primary font-bold text-xl mt-0.5">✓</span>
						<div>
							<h3 class="font-bold text-gray-800 mb-1">Valor transparente desde o início</h3>
							<p class="text-gray-600">Você sabe o preço da avaliação e das opções de acompanhamento antes de agendar.</p>
						</div>
					</div>
					<div class="flex gap-4 items-start bg-bg-light p-6 rounded-xl border border-gray-100">
						<span class="text-primary font-bold text-xl mt-0.5">✓</span>
						<div>
							<h3 class="font-bold text-gray-800 mb-1">Atendimento individual</h3>
							<p class="text-gray-600">Sessões 1 a 1, sem pressa, com atenção às necessidades de cada pessoa.</p>
						</div>
					</div>
					<div class="flex gap-4 items-start bg-bg-light p-6 rounded-xl border border-gray-100">
						<span class="text-primary font-bold text-xl mt-0.5">✓</span>
						<div>
							<h3 class="font-bold text-gray-800 mb-1">Orientação personalizada</h3>
							<p class="text-gray-600">A melhor forma de acompanhamento é definida conforme o seu caso.</p>
						</div>
					</div>
					<div class="flex gap-4 items-start bg-bg-light p-6 rounded-xl border border-gray-100">
						<span class="text-primary font-bold text-xl mt-0.5">✓</span>
						<div>
							<h3 class="font-bold text-gray-800 mb-1">Sem compromisso de pacote</h3>
							<p class="text-gray-600">Você não precisa escolher um pacote antes da avaliação: a opção de continuidade é definida em conjunto.</p>
						</div>
					</div>
	
				</div>
			</div>
		</section>

		<!-- FAQ -->
		<section class="py-16 md:py-24 bg-white">
			<div class="container mx-auto px-4 max-w-4xl">
				<div class="text-center mb-12">
					<span class="inline-block bg-primary/10 text-primary px-4 py-1.5 rounded-full font-semibold text-sm mb-4">Perguntas frequentes</span>
					<h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-4">Perguntas frequentes sobre preço da acupuntura</h2>
					<p class="text-lg text-gray-600">Principais dúvidas sobre valores, sessões e agendamento na Valda Acupuntura.</p>
				</div>

				<div class="space-y-4">
					{faqItems.map((item) => (
						<details class="group bg-white rounded-lg shadow-sm open:shadow-md transition-shadow border border-gray-100">
							<summary class="flex justify-between items-center p-5 font-bold text-primary cursor-pointer list-none select-none">
								<span>{item.question}</span>
								<span class="text-2xl font-light transform group-open:rotate-45 transition-transform text-secondary">+</span>
							</summary>

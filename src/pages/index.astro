---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { Image, getImage } from 'astro:assets';
import heroImgSource from '../assets/hero-premium.webp';
import valdaImg from '../assets/valda-real.webp';

// Pre-optimize hero image
const heroImgOptimized = await getImage({
  src: heroImgSource, 
  format: 'avif',
  width: 800,
});
---

<Layout
  title="Clínica de Acupuntura em São Paulo | Dra. Valda"
  description="Clínica de acupuntura em São Paulo, na Vila da Saúde. Atendimento individual com a Dra. Valda Fernandes e 20 anos de experiência. Agende sua avaliação."
  heroPreloadUrl={heroImgOptimized.src}
  canonicalUrl="https://valdaacupuntura.com.br/">

<!-- Schema.org Avançado (LocalBusiness, MedicalBusiness, FAQ) -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["LocalBusiness", "MedicalBusiness", "MedicalClinic"],
      "@id": "https://valdaacupuntura.com.br/#clinic",
      "name": "Valda Acupuntura",
      "description": "Clínica de acupuntura em São Paulo, na Vila da Saúde. Atendimento individual com a Dra. Valda Fernandes e 20 anos de experiência.",
      "image": "https://valdaacupuntura.com.br/valda-real.webp",
      "telephone": "+5511983134656",
      "sameAs": [
        "https://share.google/wuk8xDQ31yvDVkt3G"
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "reviewCount": "132"
      },
      "review": [
        {
          "@type": "Review",
          "author": {
            "@type": "Person",
            "name": "Giselle Florencio"
          },
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5"
          },
          "reviewBody": "Atendimento impecável, muito atenciosa, cuidadosa e extremamente profissional. Passa segurança desde a primeira consulta e explica tudo com muita clareza. Recomendo demais!"
        },
        {
          "@type": "Review",
          "author": {
            "@type": "Person",
            "name": "Tayssa Silva"
          },
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5"
          },
          "reviewBody": "Clínica excelente, atendimento impecável do começo ao fim. Profissional de mão cheia, muito cuidadosa e detalhista. Super recomendo!"
        }
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "R. Maquerobi, 156",
        "addressLocality": "São Paulo",
        "addressRegion": "SP",
        "addressCountry": "BR"
      },
      "medicalSpecialty": "Acupuncture",
      "priceRange": "$$",
      "areaServed": "São Paulo",
      "availableService": [
        {
          "@type": "MedicalTherapy",
          "name": "Acupuntura para Ansiedade",
          "description": "Tratamento natural para controle de estresse e ansiedade."
        },
        {
          "@type": "MedicalTherapy",
          "name": "Acupuntura para Enxaqueca",
          "description": "Alívio de dores de cabeça tensionais e enxaquecas."
        },
        {
          "@type": "MedicalTherapy",
          "name": "Acupuntura para Dor nas Costas",
          "description": "Tratamento para dores na coluna, lombar e nervo ciático."
        },
        {
          "@type": "MedicalTherapy",
          "name": "Acupuntura para Insônia",
          "description": "Reequilíbrio do sistema nervoso para melhora da qualidade do sono."
        }
      ],
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "08:00",
          "closes": "20:00"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Onde fica a clínica de acupuntura?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nossa clínica de acupuntura fica na Rua Maquerobi, 156 - Vila da Saúde, na Zona Sul de São Paulo."
          }
        },
        {
          "@type": "Question",
          "name": "A clínica fica perto do Metrô Praça da Árvore?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim! A clínica é de muito fácil acesso, localizada a poucos minutos de caminhada do Metrô Praça da Árvore, na Zona Sul."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto custa a avaliação?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A avaliação inicial tem o valor de R$ 250."
          }
        },
        {
          "@type": "Question",
          "name": "Como agendar uma avaliação?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O agendamento é feito de forma rápida e direta pelo nosso WhatsApp: (11) 98313-4656."
          }
        }
      ]
    }
  ]
})} />

<main>
  <Header />
  
  <!-- 1. HERO -->
  <section class="relative py-20 md:py-32 text-center overflow-hidden">
    <div class="sr-only">
      Clínica de acupuntura em São Paulo, Vila da Saúde, Zona Sul.
    </div>
    <!-- Background Image -->
    <img 
      src={heroImgOptimized.src}
      alt="Clínica de Acupuntura em São Paulo" 
      class="absolute inset-0 w-full h-full object-cover object-center z-0"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      width={1920}
      height={1080}
    />
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#e8f5e9]/95 to-white/95 z-0"></div>
    
    <div class="container mx-auto px-4 max-w-4xl relative z-10">
      <!-- Prova Social Imediata -->
      <div class="inline-flex items-center gap-2 bg-yellow-100 text-yellow-800 px-5 py-2.5 rounded-full font-bold text-sm mb-6 border border-yellow-200 shadow-sm mx-auto animate-fade-in">
        <svg class="w-4 h-4 text-yellow-500 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        4,8/5 no Google • 132+ avaliações
      </div>

      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-primary leading-tight mb-6 font-bold">
        Clínica de Acupuntura em São Paulo
      </h1>
      
      <p class="text-xl text-gray-700 mb-8 max-w-3xl mx-auto leading-relaxed">
        Atendimento individual com a <strong class="text-primary font-bold">Dra. Valda Fernandes</strong>, com 20 anos de experiência em Eletroacupuntura, na Vila da Saúde, próximo ao Metrô Praça da Árvore.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
        <a href="https://wa.me/5511983134656?text=Olá,%20busco%20uma%20clínica%20de%20acupuntura.%20Gostaria%20de%20agendar%20uma%20avaliação." 
           class="group relative bg-secondary text-white px-8 py-4 rounded-full font-bold text-lg shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all inline-flex items-center gap-3 w-full sm:w-auto justify-center overflow-hidden">
          <span class="absolute inset-0 bg-white/20 rounded-full scale-0 group-hover:scale-150 transition-transform duration-500 origin-center"></span>
          <svg class="w-6 h-6 relative z-10" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.47-.297z" /></svg>
          <span class="relative z-10">Agendar avaliação pelo WhatsApp</span>
        </a>
        <a href="#localizacao"
           class="group relative bg-white text-gray-700 border-2 border-gray-200 px-8 py-4 rounded-full font-bold text-lg shadow-sm hover:border-primary hover:text-primary transition-all inline-flex items-center gap-3 w-full sm:w-auto justify-center">
          <span>Como chegar</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. LOCALIZAÇÃO -->
  <section id="localizacao" class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="flex-1 text-left">
          <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-6">Clínica de Acupuntura na Vila da Saúde, Zona Sul de São Paulo</h2>
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            Nossa clínica está localizada em uma região de fácil acesso na Zona Sul de São Paulo. Ficamos muito próximos ao Metrô Praça da Árvore, garantindo tranquilidade para você chegar ao seu atendimento, seja de carro ou transporte público.
          </p>
          <div class="bg-bg-light border-l-4 border-primary p-6 rounded-r-lg mb-8 shadow-sm">
            <p class="text-lg text-gray-800 font-medium mb-2">📍 Endereço:</p>
            <p class="text-gray-700">R. Maquerobi, 156 - Vila da Saúde<br/>São Paulo - SP</p>
          </div>
          <a href="https://maps.google.com/?q=R.+Maquerobi,+156+-+Vila+da+Saúde,+São+Paulo+-+SP" target="_blank" rel="noopener noreferrer" class="text-primary font-bold hover:text-secondary flex items-center gap-2 text-lg transition-all underline decoration-2 underline-offset-4">
            Ver rota no Google Maps <span class="text-xl">&rarr;</span>
          </a>
        </div>
        <div class="flex-1 w-full h-80 bg-gray-200 rounded-2xl overflow-hidden shadow-lg border border-gray-100">
          <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3656.051229712607!2d-46.6372173!3d-23.6024959!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94ce5a5a1f6a4bbd%3A0x6b7db0848e3e46!2sR.%20Maquerobi%2C%20156%20-%20Vila%20da%20Sa%C3%BAde%2C%20S%C3%A3o%20Paulo%20-%20SP%2C%2004053-030!5e0!3m2!1spt-BR!2sbr!4v1700000000000" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. PROPOSTA DE VALOR -->
  <section class="py-16 md:py-24 bg-bg-light">
    <div class="container mx-auto px-4 max-w-5xl text-center">
      <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-6">Uma clínica de acupuntura focada em atendimento individual</h2>
      <p class="text-lg text-gray-600 leading-relaxed mb-12 max-w-3xl mx-auto">
        Aqui você recebe uma abordagem personalizada. Acreditamos que a acupuntura funciona melhor quando existe um acompanhamento próximo e dedicado a cada paciente, entendendo seu momento de vida.
      </p>
      
      <div class="grid md:grid-cols-3 gap-8 text-left">
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
          <div class="text-4xl mb-4">🩺</div>
          <h3 class="font-serif text-xl font-bold text-gray-800 mb-3">Avaliação Detalhada</h3>
          <p class="text-gray-600">Entendemos seu histórico e suas necessidades específicas antes de iniciar qualquer protocolo ou aplicação.</p>
        </div>
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
          <div class="text-4xl mb-4">🎯</div>
          <h3 class="font-serif text-xl font-bold text-gray-800 mb-3">Abordagem Personalizada</h3>
          <p class="text-gray-600">Tratamentos adaptados para o seu caso, acompanhando sua evolução de forma clínica a cada nova sessão.</p>
        </div>
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
          <div class="text-4xl mb-4">⭐</div>
          <h3 class="font-serif text-xl font-bold text-gray-800 mb-3">Experiência Comprovada</h3>
          <p class="text-gray-600">A segurança de ser atendido por uma especialista com 20 anos de experiência prática e resultados.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. TRATAMENTOS -->
  <section id="tratamentos" class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-4">Conheça os tratamentos</h2>
        <p class="text-lg text-gray-600 leading-relaxed">
          Nossos protocolos são aplicados de acordo com a avaliação inicial, podendo auxiliar no manejo e alívio de diferentes quadros.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 lg:gap-10">
        <!-- Tratamento 1 -->
        <div class="bg-bg-light p-8 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-14 h-14 bg-primary/10 text-primary rounded-full flex items-center justify-center text-3xl shadow-inner">🧘‍♀️</div>
            <h3 class="font-serif text-2xl font-bold text-gray-800">Ansiedade e Estresse</h3>
          </div>
          <p class="text-gray-600 mb-6 text-lg leading-relaxed">Abordagem que pode complementar o manejo de estresse e ansiedade. Cada pessoa responde de forma única ao tratamento.</p>
          <a href="/tratamentos/acupuntura-ansiedade" class="text-primary font-bold hover:text-secondary flex items-center gap-2 text-lg underline decoration-2 underline-offset-4 transition-colors">
            Conheça o tratamento <span class="text-xl">&rarr;</span>
          </a>
        </div>

        <!-- Tratamento 2 -->
        <div class="bg-bg-light p-8 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-14 h-14 bg-primary/10 text-primary rounded-full flex items-center justify-center text-3xl shadow-inner">🌙</div>
            <h3 class="font-serif text-2xl font-bold text-gray-800">Insônia</h3>
          </div>
          <p class="text-gray-600 mb-6 text-lg leading-relaxed">Técnicas que podem auxiliar na regulação do sono. O acompanhamento contínuo ajuda a ajustar o protocolo.</p>
          <a href="/tratamentos/acupuntura-insonia" class="text-primary font-bold hover:text-secondary flex items-center gap-2 text-lg underline decoration-2 underline-offset-4 transition-colors">
            Conheça o tratamento <span class="text-xl">&rarr;</span>
          </a>
        </div>

        <!-- Tratamento 3 -->
        <div class="bg-bg-light p-8 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-14 h-14 bg-primary/10 text-primary rounded-full flex items-center justify-center text-3xl shadow-inner">⚡</div>
            <h3 class="font-serif text-2xl font-bold text-gray-800">Dor Ciática e Lombar</h3>
          </div>
          <p class="text-gray-600 mb-6 text-lg leading-relaxed">Trabalhamos com foco na descompressão e na redução da inflamação local, buscando proporcionar conforto e alívio.</p>
          <a href="/tratamentos/acupuntura-dor-ciatica" class="text-primary font-bold hover:text-secondary flex items-center gap-2 text-lg underline decoration-2 underline-offset-4 transition-colors">
            Conheça o tratamento <span class="text-xl">&rarr;</span>
          </a>
        </div>

        <!-- Tratamento 4 -->
        <div class="bg-bg-light p-8 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-14 h-14 bg-primary/10 text-primary rounded-full flex items-center justify-center text-3xl shadow-inner">🤕</div>
            <h3 class="font-serif text-2xl font-bold text-gray-800">Enxaqueca</h3>
          </div>
          <p class="text-gray-600 mb-6 text-lg leading-relaxed">Foco em reduzir gatilhos tensionais no pescoço e cabeça, com o objetivo de proporcionar maior bem-estar no dia a dia.</p>
          <a href="/tratamentos/acupuntura-enxaqueca" class="text-primary font-bold hover:text-secondary flex items-center gap-2 text-lg underline decoration-2 underline-offset-4 transition-colors">
            Conheça o tratamento <span class="text-xl">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. AUTORIDADE DA DRA. VALDA -->
  <section id="especialista" class="py-16 md:py-24 bg-primary text-white overflow-hidden">
    <div class="container mx-auto px-4 max-w-6xl flex flex-col md:flex-row items-center gap-12">
      <div class="flex-1 w-full max-w-md relative order-2 md:order-1">
        <div class="absolute bottom-[-20px] right-[-20px] w-full h-full bg-white/10 rounded-2xl -z-10"></div>
        <Image 
          src={valdaImg} 
          alt="Dra Valda Fernandes em consulta de Acupuntura na Zona Sul de São Paulo" 
          width={600} 
          height={600} 
          class="rounded-2xl shadow-2xl w-full h-auto object-cover aspect-square border-4 border-white/10"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="flex-1 text-left order-1 md:order-2">
        <h2 class="font-serif text-3xl md:text-5xl font-bold mb-6">Conheça a Dra. Valda Fernandes</h2>
        <p class="text-white/95 text-xl mb-6 leading-relaxed font-light">
          Com <strong>20 anos de experiência clínica</strong>, a Dra. Valda une a precisão da Eletroacupuntura à sabedoria da Medicina Tradicional Chinesa, garantindo um acompanhamento seguro, dedicado e verdadeiramente profissional.
        </p>
        
        <ul class="space-y-4 mb-8">
          <li class="flex items-center gap-3 text-lg">
            <svg class="w-6 h-6 text-green-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            20 anos de experiência clínica comprovada
          </li>
          <li class="flex items-center gap-3 text-lg">
            <svg class="w-6 h-6 text-green-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Foco em Eletroacupuntura e protocolos individualizados
          </li>
          <li class="flex items-center gap-3 text-lg">
            <svg class="w-6 h-6 text-green-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Atendimento 1 a 1, sem pressa, com foco na sua qualidade de vida
          </li>
        </ul>

        <a href="https://wa.me/5511983134656?text=Olá,%20gostaria%20de%20agendar%20uma%20avaliação%20com%20a%20Dra.%20Valda." class="inline-flex justify-center items-center gap-3 bg-secondary text-white px-8 py-4 rounded-full font-bold hover:bg-white hover:text-primary transition-all shadow-xl text-lg w-full md:w-auto">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.47-.297z" /></svg>
          Agendar avaliação pelo WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- 7. DEPOIMENTOS -->
  <section id="avaliacoes" class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-4">Avaliações de Clientes</h2>
        <div class="flex items-center justify-center gap-1 mb-4">
          {[1, 2, 3, 4, 5].map(() => (
            <svg class="w-6 h-6 text-yellow-500 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
          <span class="ml-2 font-bold text-gray-700">4.8/5 (132+ avaliações)</span>
        </div>
        <p class="text-lg text-gray-600 leading-relaxed font-medium">
          Nossa clínica é altamente avaliada no Google, sendo referência em atendimento humanizado na região da Vila da Saúde e Zona Sul de São Paulo.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Avaliação 1 -->

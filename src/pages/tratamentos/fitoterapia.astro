---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { Image, getImage } from 'astro:assets';
import heroImgSource from '../../assets/hero-premium.webp';
import valdaImg from '../../assets/valda-real.webp';

const heroImgOptimized = await getImage({
  src: heroImgSource, 
  format: 'avif',
  width: 800,
});
---

<Layout
  title="Fitoterapia Chinesa em São Paulo | Clínica Vila da Saúde"
  description="Fitoterapia chinesa em São Paulo. Tratamento natural com plantas medicinais para ansiedade, insônia, dores e digestão. Clínica Vila da Saúde - Zona Sul."
  canonicalUrl="https://valdaacupuntura.com.br/tratamentos/fitoterapia/"
  heroPreloadUrl={heroImgOptimized.src}>

  <main>
  <Header />

  <!-- FAQ JSON-LD Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "O que é fitoterapia chinesa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A fitoterapia chinesa é uma terapêutica milenar que utiliza plantas medicinais para equilibrar o organismo. Cada fórmula é personalizada com base na avaliação individual do paciente."
        }
      },
      {
        "@type": "Question",
        "name": "Fitoterapia funciona junto com acupuntura?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sim. A combinação de fitoterapia e acupuntura potencializa os resultados, atuando por vias complementares para o equilíbrio do organismo."
        }
      },
      {
        "@type": "Question",
        "name": "As fórmulas fitoterápicas são seguras?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sim. Utilizamos plantas de alta qualidade, selecionadas e preparadas com rigor. Cada fórmula é individualizada e acompanhada profissionalmente."
        }
      }
    ]
  })} />

    <!-- HERO -->
    <section class="relative py-20 md:py-32 text-center overflow-hidden">
      <img src={heroImgOptimized.src} alt="Fitoterapia chinesa em São Paulo" class="absolute inset-0 w-full h-full object-cover object-center z-0" fetchpriority="high" loading="eager" decoding="async" width={1920} height={1080} />
      <div class="absolute inset-0 bg-gradient-to-b from-[#e8f5e9]/95 to-white/90 z-0"></div>
      
      <div class="container mx-auto px-4 max-w-4xl relative z-10">
        <span class="inline-flex items-center gap-2 bg-[#e6fffa] text-[#047857] px-5 py-2.5 rounded-full font-semibold text-sm mb-6 border border-[#b7eb8f] shadow-sm animate-fade-in mx-auto">
          Dra. Valda Fernandes • 20 Anos de Experiência
        </span>
        <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-primary leading-tight mb-6 font-bold">
          Fitoterapia Chinesa em São Paulo
        </h1>
        <p class="text-xl text-gray-700 mb-8 max-w-3xl mx-auto leading-relaxed">
          Tratamento natural com <strong class="text-primary">plantas medicinais chinesas</strong> para ansiedade, insônia, dores crônicas e problemas digestivos. Protocolo personalizado na Vila da Saúde, Zona Sul.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
          <a href="https://wa.me/5511983134656?text=Ol%C3%A1,%20gostaria%20de%20saber%20mais%20sobre%20fitoterapia%20chinesa.&utm_source=site&utm_medium=fitoterapia_hero&utm_campaign=whatsapp_agendamento" class="bg-secondary text-white px-8 py-4 rounded-full font-bold text-lg shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all inline-flex items-center gap-3 w-full sm:w-auto justify-center" target="_blank" rel="noopener" aria-label="Agendar avaliação de fitoterapia pelo WhatsApp">
            💬 Agendar com a Dra. Valda
          </a>
          <a href="tel:+5511983134656" class="bg-white text-primary border-2 border-primary px-8 py-4 rounded-full font-bold text-lg shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all inline-flex items-center gap-3 w-full sm:w-auto justify-center" aria-label="Ligar para a clínica">
            📞 Ligar Agora
          </a>
        </div>
      </div>
    </section>

    <!-- O QUE É FITOTERAPIA -->
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4 max-w-4xl text-center">
        <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-6">O que é Fitoterapia Chinesa?</h2>
        <p class="text-lg text-gray-600 leading-relaxed mb-8">
          A fitoterapia chinesa é uma das bases da Medicina Tradicional Chinesa, com mais de 3 mil anos de história. Utiliza plantas medicinais — individualizadas ou em fórmulas combinadas — para restaurar o equilíbrio do organismo, tratar doenças e promover saúde de forma natural.
        </p>
        <p class="text-lg text-gray-600 leading-relaxed">
          Diferente da automedicação com chás prontos, a fitoterapia chinesa prescrita por profissional envolve uma avaliação completa do paciente e a montagem de uma fórmula personalizada, com dosagem e composição ajustadas ao longo do tratamento.
        </p>
      </div>
    </section>

    <!-- COMO FUNCIONA -->
    <section class="py-16 bg-bg-light">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-4">Como funciona o tratamento?</h2>
          <p class="text-lg text-gray-600 leading-relaxed">
            O processo é simples, seguro e totalmente personalizado.
          </p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 text-center">
            <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">1</div>
            <h3 class="font-bold text-xl text-gray-800 mb-3">Avaliação Individual</h3>
            <p class="text-gray-600">A Dra. Valda analisa seu histórico, sintomas, constituição e(define a abordagem fitoterápica mais adequada.</p>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 text-center">
            <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">2</div>
            <h3 class="font-bold text-xl text-gray-800 mb-3">Fórmula Personalizada</h3>
            <p class="text-gray-600">É montada uma combinação exclusiva de plantas medicinais, com dosagem e composição ajustadas ao seu caso.</p>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 text-center">
            <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">3</div>
            <h3 class="font-bold text-xl text-gray-800 mb-3">Acompanhamento Contínuo</h3>
            <p class="text-gray-600">A fórmula é ajustada a cada consulta conforme sua evolução, garantindo resultados progressivos e seguros.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- PARA QUE É INDICADA -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-4">Para que é indicada?</h2>
          <p class="text-lg text-gray-600 leading-relaxed">
            A fitoterapia chinesa pode ser indicada como abordagem complementar para diferentes quadros:
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4 p-6 bg-gray-50 rounded-xl">
            <div class="w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center text-2xl flex-shrink-0">🧘‍♀️</div>
            <div>
              <h3 class="font-bold text-lg text-gray-800 mb-2">Ansiedade e Estresse</h3>
              <p class="text-gray-600">Plantas com ação ansiolítica e reguladora do sistema nervoso, auxiliando no equilíbrio emocional.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-6 bg-gray-50 rounded-xl">
            <div class="w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center text-2xl flex-shrink-0">🌙</div>
            <div>
              <h3 class="font-bold text-lg text-gray-800 mb-2">Insônia e Distúrbios do Sono</h3>
              <p class="text-gray-600">Fórmulas que promovem relaxamento e regulam o ritmo circadiano para sono restaurador.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-6 bg-gray-50 rounded-xl">
            <div class="w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center text-2xl flex-shrink-0">⚡</div>
            <div>
              <h3 class="font-bold text-lg text-gray-800 mb-2">Dores Crônicas</h3>
              <p class="text-gray-600">Plantas anti-inflamatórias e analgésicas que complementam o tratamento de dores lombares, ciática e enxaqueca.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-6 bg-gray-50 rounded-xl">
            <div class="w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center text-2xl flex-shrink-0">🍽️</div>
            <div>
              <h3 class="font-bold text-lg text-gray-800 mb-2">Problemas Digestivos</h3>
              <p class="text-gray-600">Regulação do trânsito intestinal, alívio de gastrites nervosas e melhora da digestão.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-6 bg-gray-50 rounded-xl">
            <div class="w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center text-2xl flex-shrink-0">🩺</div>
            <div>
              <h3 class="font-bold text-lg text-gray-800 mb-2">TPM e Cólicas</h3>
              <p class="text-gray-600">Regulação do ciclo hormonal feminino, aliviando cólicas, inchaço e alterações de humor.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-6 bg-gray-50 rounded-xl">
            <div class="w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center text-2xl flex-shrink-0">💪</div>
            <div>
              <h3 class="font-bold text-lg text-gray-800 mb-2">Imunidade e Prevenção</h3>
              <p class="text-gray-600">Fortalecimento do sistema imunológico e prevenção de doenças recorrentes.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BENEFÍCIOS -->
    <section class="py-16 bg-primary text-white">
      <div class="container mx-auto px-4 max-w-6xl flex flex-col md:flex-row items-center gap-12">
        <div class="flex-1 text-left">
          <h2 class="font-serif text-3xl md:text-4xl font-bold mb-6">Por que escolher a Dra. Valda?</h2>
          <p class="text-lg mb-4 text-white/90 font-medium">
            Especialista em Fitoterapia e Acupuntura
          </p>
          <p class="text-lg mb-4 text-white/90">
            Com 20 anos de experiência em Medicina Tradicional Chinesa, a Dra. Valda combina acupuntura e fitoterapia para um tratamento mais completo e eficaz.
          </p>
          <p class="text-lg mb-4 text-white/90">
            Formada pela UNIP com pós-graduação em Medicina Tradicional Chinesa, ela utiliza plantas medicinais de alta qualidade e fórmulas personalizadas para cada paciente.
          </p>
          <div class="mb-8 p-6 bg-white/5 rounded-xl border border-white/10">
            <p class="text-lg text-white/90 italic">
              "A combinação de acupuntura com fitoterapia fez uma diferença enorme no meu tratamento de ansiedade. Me sinto muito mais equilibrada." – Paciente
            </p>
          </div>
          <div class="bg-white/10 p-6 rounded-2xl border border-white/20">
            <h3 class="font-bold text-xl mb-2 text-green-300">Atendimento Personalizado</h3>
            <p>Sessões individuais com protocolo ajustado a cada consulta</p>
            <p>Vila da Saúde, Zona Sul — próximo ao Metrô</p>
          </div>
        </div>
        <div class="flex-1 max-w-md mx-auto">
          <Image src={valdaImg} alt="Dra. Valda Fernandes" width={500} height={500} class="rounded-2xl shadow-xl border-4 border-white/10" />
        </div>
      </div>
    </section>

    <!-- PREÇOS -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 max-w-5xl text-center">
        <h2 class="font-serif text-3xl text-primary font-bold mb-10">Valores</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-200">
            <h3 class="font-bold text-xl text-gray-800 mb-2">Avaliação Inicial</h3>
            <div class="text-3xl font-bold text-primary my-4">R$ 250</div>
            <a href="https://wa.me/5511983134656?text=Ol%C3%A1,%20quero%20agendar%20avalia%C3%A7%C3%A3o%20de%20fitoterapia.&utm_source=site&utm_medium=fitoterapia_precos_avaliacao&utm_campaign=whatsapp_agendamento" class="block w-full bg-white text-primary border-2 border-primary px-4 py-3 rounded-full font-bold hover:bg-primary hover:text-white transition-colors" target="_blank" rel="noopener" aria-label="Agendar avaliação de fitoterapia">💬 Agendar</a>
          </div>
          <div class="p-8 bg-primary rounded-2xl border border-primary text-white transform md:-translate-y-4 shadow-xl relative">
            <div class="absolute top-0 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-secondary text-white px-4 py-1 rounded-full text-sm font-bold">Mais Procurado</div>
            <h3 class="font-bold text-xl mb-2 mt-2">Pacote 4 Sessões</h3>
            <div class="text-3xl font-bold my-4">R$ 700</div>
            <a href="https://wa.me/5511983134656?text=Ol%C3%A1,%20quero%20agendar%204%20sess%C3%B5es%20com%20fitoterapia.&utm_source=site&utm_medium=fitoterapia_precos_4sessoes&utm_campaign=whatsapp_agendamento" class="block w-full bg-secondary text-white px-4 py-3 rounded-full font-bold hover:bg-white hover:text-secondary transition-colors" target="_blank" rel="noopener" aria-label="Garantir pacote de 4 sessões">✅ Garantir Pacote Agora</a>
          </div>
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-200">
            <h3 class="font-bold text-xl text-gray-800 mb-2">Pacote 10 Sessões</h3>
            <div class="text-3xl font-bold text-primary my-4">R$ 1500</div>
            <a href="https://wa.me/5511983134656?text=Ol%C3%A1,%20quero%20agendar%2010%20sess%C3%B5es%20com%20fitoterapia.&utm_source=site&utm_medium=fitoterapia_precos_10sessoes&utm_campaign=whatsapp_agendamento" class="block w-full bg-white text-primary border-2 border-primary px-4 py-3 rounded-full font-bold hover:bg-primary hover:text-white transition-colors" target="_blank" rel="noopener" aria-label="Agendar tratamento completo">✅ Tratamento Completo</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 bg-bg-light">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="font-serif text-3xl text-primary font-bold mb-8 text-center">Perguntas Frequentes</h2>
        <div class="space-y-4">
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl text-gray-800 mb-2">O que é fitoterapia chinesa?</h3>
            <p class="text-gray-600">A fitoterapia chinesa é uma terapêutica milenar que utiliza plantas medicinais para equilibrar o organismo. Cada fórmula é personalizada com base na avaliação individual do paciente.</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl text-gray-800 mb-2">Fitoterapia funciona junto com acupuntura?</h3>
            <p class="text-gray-600">Sim. A combinação de fitoterapia e acupuntura potencializa os resultados, atuando por vias complementares para o equilíbrio do organismo.</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl text-gray-800 mb-2">As fórmulas fitoterápicas são seguras?</h3>
            <p class="text-gray-600">Sim. Utilizamos plantas de alta qualidade, selecionadas e preparadas com rigor. Cada fórmula é individualizada e acompanhada profissionalmente.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="py-20 bg-white text-center">
      <div class="container mx-auto px-4">
        <h2 class="font-serif text-4xl text-primary font-bold mb-6">Comece seu tratamento natural agora!</h2>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-4">
          <a href="https://wa.me/5511983134656?text=Ol%C3%A1,%20gostaria%20de%20agendar%20avalia%C3%A7%C3%A3o%20de%20fitoterapia%20chinesa.&utm_source=site&utm_medium=fitoterapia_final_cta&utm_campaign=whatsapp_agendamento" class="bg-secondary text-white px-10 py-5 rounded-full font-bold text-xl shadow-lg hover:shadow-xl transition-all inline-flex items-center gap-3 animate-pulse-slow" target="_blank" rel="noopener" aria-label="Agendar avaliação final de fitoterapia pelo WhatsApp">
            💬 Agendar com a Dra. Valda
          </a>
          <a href="tel:+5511983134656" class="bg-white text-primary border-2 border-primary px-10 py-5 rounded-full font-bold text-xl shadow-lg hover:shadow-xl transition-all inline-flex items-center gap-3" aria-label="Ligar para a clínica">
            📞 Ligar Agora
          </a>
        </div>
      </div>
    </section>

    <footer class="bg-gray-800 text-white py-12 text-center text-sm border-t border-gray-700">
      <div class="container mx-auto px-4">
        <p class="font-bold text-lg mb-2 font-serif tracking-wide">Clínica Valda Acupuntura</p>
        <p class="opacity-80 mb-4 text-gray-300">R. Maquerobi, 156 - Vila da Saúde, São Paulo - SP</p>
        <p class="mb-6"><a href="tel:+5511983134656" class="hover:text-secondary transition-colors font-bold text-lg">(11) 98313-4656</a></p>
        <p class="opacity-50 text-xs">&copy; 2026 Valda Acupuntura. Todos os direitos reservados.</p>
      </div>
    </footer>
  </main>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { Image, getImage } from 'astro:assets';
import heroImgSource from '../../assets/hero-premium.webp';
import valdaImg from '../../assets/valda-real.webp';

const heroImgOptimized = await getImage({
  src: heroImgSource, 
  format: 'avif',
  width: 800,
});

const faqItems = [
  {
    q: "A acupuntura dói?",
    a: "Não. As agulhas utilizadas são extremamente finas (0,20 a 0,25 mm), descartáveis e de uso único. A maioria dos pacientes sente apenas um leve formigamento no início da aplicação e relaxa durante a sessão."
  },
  {
    q: "Acupuntura funciona para ansiedade?",
    a: "A acupuntura pode fazer parte de uma abordagem complementar para ansiedade, atuando no sistema nervoso e no manejo de sintomas como tensão e sono irregular. A resposta varia de pessoa para pessoa, e um atendimento personalizado permite avaliar melhor a sua situação."
  },
  {
    q: "Quantas sessões são necessárias?",
    a: "O protocolo é definido após a avaliação inicial. De forma geral, trabalhamos com pacotes de 4 ou 10 sessões, ajustados conforme a sua resposta ao longo do tratamento."
  },
  {
    q: "A acupuntura substitui o remédio ou a terapia que eu já faço?",
    a: "Não. A acupuntura é uma abordagem complementar e não substitui acompanhamento médico ou psicológico. Nunca interrompa medicamentos por conta própria: qualquer ajuste deve ser feito com o seu profissional de saúde."
  },
  {
    q: "Como funciona a sessão para ansiedade?",
    a: "A sessão começa pela avaliação: a acupunturista ouve seu relato, entende seu histórico e define os pontos de acordo com o seu quadro. Depois, as agulhas são aplicadas e você permanece em repouso ambiente tranquilo durante o tempo da sessão."
  },
  {
    q: "Qual a diferença entre acupuntura comum e eletroacupuntura?",
    a: "A eletroacupuntura aplica uma corrente elétrica de baixa intensidade nas agulhas. Em quadros de ansiedade com tensão muscular associada, ela pode ser indicada pela acupunturista para potencializar o efeito de relaxamento — sempre após avaliação do seu caso."
  },
  {
    q: "Quanto custa a avaliação para ansiedade?",
    a: "A avaliação inicial custa R$ 250. Para a continuidade, há pacotes de 4 sessões por R$ 700 e de 10 sessões por R$ 1.500. O valor é transparente e não há taxa escondida."
  },
  {
    q: "Preciso passar por avaliação antes de agendar uma sessão?",
    a: "Sim. A avaliação inicial é obrigatória e é nela que entendemos suas necessidades e definimos o protocolo mais adequado para o seu caso. É o primeiro passo de qualquer tratamento na clínica."
  }
];
---

<Layout
  title="Acupuntura para Ansiedade em São Paulo – Dra. Valda"
  description="Acupuntura para ansiedade na Vila da Saúde, SP. Abordagem complementar individual com 20 anos de experiência. Avaliação R$ 250. Agende pelo WhatsApp."
  canonicalUrl="https://valdaacupuntura.com.br/tratamentos/acupuntura-ansiedade/"
  heroPreloadUrl={heroImgOptimized.src}>

  <main>
  <Header />

  <!-- FAQ JSON-LD Schema (espelha a FAQ visível abaixo) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a }
    }))
  })} />
  <!-- MedicalWebPage + Physician Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    "name": "Acupuntura para Ansiedade | Valda Acupuntura",
    "description": "Abordagem complementar de acupuntura para ansiedade em São Paulo. Dra. Valda Fernandes, 20 anos de experiência, Vila da Saúde.",
    "about": { "@type": "Thing", "name": "Acupuntura para Ansiedade" },
    "author": {
      "@type": "Physician",
      "name": "Dra. Valda Fernandes",
      "jobTitle": "Acupunturista",
      "medicalSpecialty": "Acupuntura",
      "address": { "@type": "PostalAddress", "streetAddress": "R. Maquerobi, 156", "addressLocality": "São Paulo", "addressRegion": "SP", "addressCountry": "BR" },
      "telephone": "+5511983134656"
    }
  })} />

    <!-- ===================== HERO — O que é / para quem / próximo passo ===================== -->
    <section class="relative py-20 md:py-32 text-center overflow-hidden">
      <img src={heroImgOptimized.src} alt="Sala de atendimento da clínica de acupuntura para ansiedade na Vila da Saúde, São Paulo" class="absolute inset-0 w-full h-full object-cover object-center z-0" fetchpriority="high" loading="eager" decoding="async" width={1920} height={1080} />
      <div class="absolute inset-0 bg-gradient-to-b from-[#e8f5e9]/95 to-white/90 z-0"></div>
      
      <div class="container mx-auto px-4 max-w-4xl relative z-10">
        <span class="inline-flex items-center gap-2 bg-[#e6fffa] text-[#047857] px-5 py-2.5 rounded-full font-semibold text-sm mb-6 border border-[#b7eb8f] shadow-sm animate-fade-in mx-auto">
          4,8★ no Google • 20 anos de experiência
        </span>
        <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-primary leading-tight mb-6 font-bold">
          Acupuntura para Ansiedade em São Paulo
        </h1>
        <p class="text-xl text-gray-700 mb-8 max-w-3xl mx-auto leading-relaxed">
          Mente acelerada, tensão no corpo e noites mal dormidas? A acupuntura pode fazer parte de uma <strong class="text-primary">abordagem complementar</strong> para o manejo da ansiedade, com atendimento 100% individual na Vila da Saúde, Zona Sul de São Paulo.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
          <a href="https://wa.me/5511983134656?text=Ol%C3%A1,%20busco%20tratamento%20para%20ansiedade.%20Gostaria%20de%20agendar%20avalia%C3%A7%C3%A3o.&utm_source=site&utm_medium=ansiedade_hero&utm_campaign=whatsapp_agendamento" class="bg-secondary text-white px-8 py-4 rounded-full font-bold text-lg shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all inline-flex items-center gap-3 w-full sm:w-auto justify-center" target="_blank" rel="noopener" aria-label="Agendar avaliação de ansiedade pelo WhatsApp">
            💬 Agendar com a Dra. Valda
          </a>
          <a href="tel:+5511983134656" class="bg-white text-primary border-2 border-primary px-8 py-4 rounded-full font-bold text-lg shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all inline-flex items-center gap-3 w-full sm:w-auto justify-center" aria-label="Ligar para a clínica">
            📞 Ligar Agora
          </a>
        </div>
        <p class="mt-6 text-sm text-gray-500">📍 R. Maquerobi, 156 – Vila da Saúde • perto do Metrô Praça da Árvore</p>
      </div>
    </section>

    <!-- ===================== PROBLEMA — Reconhecer a dor do visitante ===================== -->
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4 max-w-4xl text-center">
        <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-6">Quando a mente não desliga</h2>
        <p class="text-lg text-gray-600 leading-relaxed mb-6">
          A preocupação constante suga energia, prejudica o sono e acompanha você o dia inteiro. Tensão no peito, no pescoço e nos ombros, respiração curta, dificuldade para relaxar mesmo depois do trabalho: a ansiedade se manifesta tanto na mente quanto no corpo.
        </p>
        <p class="text-lg text-gray-600 leading-relaxed">
          Quem chega até aqui normalmente já tentou de tudo — chá, respiração, remédio prescrito, terapia. A acupuntura entra como uma <strong class="text-primary">complementação</strong> ao cuidado que você já tem: uma prática que trabalha o corpo para acalmar a mente, sem substituir o seu acompanhamento médico ou psicológico.
        </p>
      </div>
    </section>

    <!-- ===================== MECANISMO — Por que funciona ===================== -->
    <section class="py-16 bg-bg-light">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-4">Como a acupuntura atua na ansiedade</h2>
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            A Medicina Tradicional Chinesa entende a ansiedade como um desequilíbrio entre corpo e mente. Na prática clínica, a estimulação de pontos específicos atua sobre o sistema nervoso, ajudando a reduzir a excitabilidade e a promover relaxamento.
          </p>
          <p class="text-lg text-gray-600 leading-relaxed">
            Estudos publicados no <em>Journal of Acupuncture and Meridian Studies</em> descrevem a liberação de endorfinas e a regulação do eixo hipotálamo-hipófise-adrenal (HPA), envolvido na resposta ao estresse. A OMS reconhece a acupuntura como abordagem complementar em quadros relacionados a transtornos de ansiedade — sempre como parte de um cuidado acompanhado por profissionais de saúde.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 text-left">
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
            <div class="text-4xl mb-4">🧠</div>
            <h3 class="font-serif text-xl font-bold text-gray-800 mb-3">Regulação do sistema nervoso</h3>
            <p class="text-gray-600">A estimulação dos pontos auxilia na transição do estado de alerta para o estado de repouso — o que você sente como "a mente finalmente desacelerar".</p>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
            <div class="text-4xl mb-4">💆</div>
            <h3 class="font-serif text-xl font-bold text-gray-800 mb-3">Alívio da tensão no corpo</h3>
            <p class="text-gray-600">Ombros travados, mandíbula apertada, peito tenso: a sessão trabalha as manifestações físicas que acompanham a ansiedade.</p>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
            <div class="text-4xl mb-4">🌙</div>
            <h3 class="font-serif text-xl font-bold text-gray-800 mb-3">Sono mais regulado</h3>
            <p class="text-gray-600">Muitos pacientes relatam adormecer com mais facilidade ao longo do protocolo — o sono é um dos primeiros sinais acompanhados na evolução.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== PARA QUEM — Sinais mais procurados ===================== -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-4">Para quem é a acupuntura para ansiedade</h2>
          <p class="text-lg text-gray-600">Sinais que levam muitos pacientes a procurarem a clínica:</p>
        </div>
        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="flex items-start gap-4 bg-bg-light p-6 rounded-2xl border border-gray-100">
            <span class="text-primary text-2xl mt-1">✓</span>
            <p class="text-gray-700 leading-relaxed">Preocupação constante e pensamentos que não param, mesmo fora do horário de trabalho</p>
          </div>
          <div class="flex items-start gap-4 bg-bg-light p-6 rounded-2xl border border-gray-100">
            <span class="text-primary text-2xl mt-1">✓</span>
            <p class="text-gray-700 leading-relaxed">Tensão física: ombros, pescoço e mandíbula sempre contraídos</p>
          </div>
          <div class="flex items-start gap-4 bg-bg-light p-6 rounded-2xl border border-gray-100">
            <span class="text-primary text-2xl mt-1">✓</span>
            <p class="text-gray-700 leading-relaxed">Sono leve e interrompido, com dificuldade para desacelerar à noite</p>
          </div>
          <div class="flex items-start gap-4 bg-bg-light p-6 rounded-2xl border border-gray-100">
            <span class="text-primary text-2xl mt-1">✓</span>
            <p class="text-gray-700 leading-relaxed">Desejo de somar uma abordagem natural ao acompanhamento que já faço</p>
          </div>
        </div>
        <p class="text-sm text-gray-500 text-center mt-8 max-w-2xl mx-auto">A acupuntura não substitui diagnóstico nem tratamento médico ou psicológico. Em caso de crise ou agravamento, procure o seu profissional de saúde.</p>
      </div>
    </section>

    <!-- ===================== PROCESSO — Como é o atendimento ===================== -->
    <section class="py-16 bg-bg-light">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center mb-14">
          <span class="inline-block bg-primary/10 text-primary px-4 py-1.5 rounded-full font-semibold text-sm mb-4">Como funciona</span>
          <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-4">O protocolo para ansiedade, passo a passo</h2>
          <p class="text-lg text-gray-600">Cada etapa é definida com você, sem pressa e sem fórmula pronta.</p>
        </div>
        <div class="grid md:grid-cols-4 gap-8 text-center">
          <div class="relative">
            <div class="w-14 h-14 bg-primary text-white rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-4 shadow-lg">1</div>
            <h3 class="font-bold text-lg text-gray-800 mb-2">Avaliação inicial</h3>
            <p class="text-gray-600 text-sm">Ouvimos seu histórico, seu momento de vida e o que você já tentou até agora.</p>
          </div>
          <div class="relative">
            <div class="w-14 h-14 bg-primary text-white rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-4 shadow-lg">2</div>
            <h3 class="font-bold text-lg text-gray-800 mb-2">Definição dos pontos</h3>
            <p class="text-gray-600 text-sm">Os pontos de acupuntura são escolhidos de acordo com o seu quadro específico.</p>
          </div>
          <div class="relative">
            <div class="w-14 h-14 bg-primary text-white rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-4 shadow-lg">3</div>
            <h3 class="font-bold text-lg text-gray-800 mb-2">Sessão individual</h3>
            <p class="text-gray-600 text-sm">Atendimento 1 a 1 em ambiente tranquilo, com agulhas descartáveis de uso único.</p>
          </div>
          <div class="relative">
            <div class="w-14 h-14 bg-primary text-white rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-4 shadow-lg">4</div>
            <h3 class="font-bold text-lg text-gray-800 mb-2">Acompanhamento</h3>
            <p class="text-gray-600 text-sm">O protocolo é ajustado a cada nova sessão conforme a sua evolução.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== PROVA — Autoridade ===================== -->
    <section class="py-16 bg-primary text-white">
      <div class="container mx-auto px-4 max-w-6xl flex flex-col md:flex-row items-center gap-12">
        <div class="flex-1 text-left">
          <h2 class="font-serif text-3xl md:text-4xl font-bold mb-6">Dra. Valda Fernandes</h2>
          <p class="text-lg mb-4 text-white/90 font-medium">
            Atendimento personalizado e humanizado na Vila da Saúde

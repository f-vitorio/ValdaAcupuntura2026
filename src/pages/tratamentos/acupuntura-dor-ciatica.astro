---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { Image, getImage } from 'astro:assets';
import heroImgSource from '../../assets/hero-premium.webp';
import valdaImg from '../../assets/valda-real.webp';

const heroImgOptimized = await getImage({
  src: heroImgSource, 
  format: 'avif',
  width: 800,
});
---

<Layout
  title="Acupuntura para dor ciática São Paulo | Clínica na Vila da Saúde"
  description="Buscando acupuntura para dor ciática São Paulo? Alívio imediato para nervo ciático e dor lombar. Clínica na Vila da Saúde - Zona Sul, próximo ao Metrô Praça da Árvore."
  canonicalUrl="https://valdaacupuntura.com.br/tratamentos/acupuntura-dor-ciatica/"
  heroPreloadUrl={heroImgOptimized.src}>

  <main>
  <Header />

  <!-- FAQ JSON-LD Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Acupuntura dói mais em áreas inflamadas?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Não dói. A aplicação é segura e utilizamos pontos no corpo para relaxar a dor lombar, gerando conforto no paciente sem causar dor adicional."
        }
      },
      {
        "@type": "Question",
        "name": "Funciona para a dor ciática crônica?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A acupuntura pode fazer parte de uma abordagem complementar para dor ciática crônica. A resposta varia de pessoa para pessoa, e um atendimento personalizado permite avaliar melhor a sua situação."
        }
      },
      {
        "@type": "Question",
        "name": "Quantas sessões são necessárias para voltar a andar?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Normalmente o alívio das dores intensas surge nas primeiras sessões, sendo recomendado os pacotes de 4 a 10 sessões para garantir a estabilidade do quadro sem recidivas."
        }
      }
    ]
  })} />

    <!-- HERO -->
    <section class="relative py-20 md:py-32 text-center overflow-hidden">
      <img src={heroImgOptimized.src} alt="Acupuntura para dor ciática São Paulo" class="absolute inset-0 w-full h-full object-cover object-center z-0" fetchpriority="high" loading="eager" decoding="async" width={1920} height={1080} />
      <div class="absolute inset-0 bg-gradient-to-b from-[#e8f5e9]/95 to-white/90 z-0"></div>
      
      <div class="container mx-auto px-4 max-w-4xl relative z-10">
        <span class="inline-flex items-center gap-2 bg-[#e6fffa] text-[#047857] px-5 py-2.5 rounded-full font-semibold text-sm mb-6 border border-[#b7eb8f] shadow-sm animate-fade-in mx-auto">
          Dra. Valda Fernandes • 20 Anos de Experiência
        </span>
        <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-primary leading-tight mb-6 font-bold">
          Acupuntura para dor ciática são paulo
        </h1>
        <p class="text-xl text-gray-700 mb-8 max-w-3xl mx-auto leading-relaxed">
          Sofrendo com dor lombar, pinçamento no nervo ciático ou travamento nas costas? Encontre alívio através da <strong class="text-primary">acupuntura para dor ciática são paulo</strong>. Tratamento natural para dificuldade de movimento na Vila da Saúde, Zona Sul, próximo ao Metrô Praça da Árvore.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
          <a href="https://wa.me/5511983134656?text=Olá,%20busco%20tratamento%20para%20dor%20ciática.%20Gostaria%20de%20agendar%20avaliação." class="bg-secondary text-white px-8 py-4 rounded-full font-bold text-lg shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all inline-flex items-center gap-3 w-full sm:w-auto justify-center">
            💬 Agendar com a Dra. Valda
          </a>
        </div>
      </div>
    </section>

    <!-- DOR DO PACIENTE -->
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4 max-w-4xl text-center">
        <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-6">A frustração de conviver com o travamento</h2>
        <p class="text-lg text-gray-600 leading-relaxed mb-8">
          A dor lombar e as pontadas agudas do nervo ciático tiram completamente a sua autonomia. O medo de agravar o travamento cria enorme dificuldade de movimento. E o pior: a falta de resultado com anti-inflamatórios e gastos excessivos com remédios apenas sobrecarregam seu corpo, impactando a sua vida profissional e pessoal sem curar a verdadeira inflamação.
        </p>
      </div>
    </section>

    <!-- SOLUÇÃO (ACUPUNTURA) -->
    <section class="py-16 bg-bg-light">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-4">A eficácia da acupuntura para dor ciática são paulo</h2>
          <p class="text-lg text-gray-600 leading-relaxed">
            Nós tratamos a causa raiz da sua dor! Através de pontos específicos e do uso da eletroacupuntura, promovemos um profundo relaxamento muscular, descompressão e ação anti-inflamatória direta no trajeto do nervo ciático e da região lombar.
          </p>
        </div>
      </div>
    </section>

    <!-- BENEFÍCIOS -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="grid md:grid-cols-2 gap-8">
          <div class="p-6 bg-gray-50 rounded-xl">
            <h3 class="font-bold text-xl text-primary mb-3">Fim do Travamento</h3>
            <p class="text-gray-600">Alívio real e descompressão rápida da coluna lombar, permitindo que você volte a se movimentar com liberdade.</p>
          </div>
          <div class="p-6 bg-gray-50 rounded-xl">
            <h3 class="font-bold text-xl text-primary mb-3">Abordagem Complementar</h3>
            <p class="text-gray-600">Tratamento natural que pode complementar outras terapias, incluindo medicações, sem efeitos colaterais pesados.</p>
          </div>
          <div class="p-6 bg-gray-50 rounded-xl">
            <h3 class="font-bold text-xl text-primary mb-3">Desinflamação Profunda</h3>
            <p class="text-gray-600">A eletroacupuntura estimula a recuperação celular, focando diretamente no nervo ciático inflamado sem efeitos colaterais.</p>
          </div>
          <div class="p-6 bg-gray-50 rounded-xl">
            <h3 class="font-bold text-xl text-primary mb-3">Melhorar a Rotina</h3>
            <p class="text-gray-600">Retome a sua qualidade de vida, trabalhando, dormindo e praticando suas atividades sem a sombra constante da dor.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- PROVA SOCIAL & AUTORIDADE -->
    <section class="py-16 bg-primary text-white">
      <div class="container mx-auto px-4 max-w-6xl flex flex-col md:flex-row items-center gap-12">
        <div class="flex-1 text-left">
          <h2 class="font-serif text-3xl md:text-4xl font-bold mb-6">Dra. Valda Fernandes</h2>
          <p class="text-lg mb-4 text-white/90 font-medium">
            Atendimento Personalizado Contra a Dor
          </p>
          <p class="text-lg mb-4 text-white/90">
            Especialista no tratamento de dores crônicas com 20 anos de experiência, unindo Medicina Chinesa e Eletroacupuntura.
          </p>
          <div class="mb-8 p-6 bg-white/5 rounded-xl border border-white/10">
            <p class="text-lg text-white/90 italic">
              "Cheguei travado na clínica, com muita dor no ciático, mal conseguia andar. Com poucas sessões de acupuntura, minha vida voltou ao normal. Profissionalismo e atendimento humanizado incríveis!" – Marcelo D.
            </p>
          </div>
          <div class="bg-white/10 p-6 rounded-2xl border border-white/20">
            <h3 class="font-bold text-xl mb-2 text-green-300">Localização Privilegiada</h3>
            <p>Vila da Saúde, Zona Sul de São Paulo</p>
            <p>Fácil acesso, próximo ao Metrô Praça da Árvore</p>
          </div>
        </div>
        <div class="flex-1 max-w-md mx-auto">
          <Image src={valdaImg} alt="Dra. Valda Fernandes" width={500} height={500} class="rounded-2xl shadow-xl border-4 border-white/10" />
        </div>
      </div>
    </section>

    <!-- PREÇOS -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 max-w-5xl text-center">
        <h2 class="font-serif text-3xl text-primary font-bold mb-10">Tabela de Preços e Tratamentos</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-200">
            <h3 class="font-bold text-xl text-gray-800 mb-2">Primeira Consulta</h3>
            <div class="text-3xl font-bold text-primary my-4">R$ 250</div>
            <a href="https://wa.me/5511983134656?text=Olá,%20quero%20agendar%20minha%20primeira%20consulta%20para%20dor%20ciática." class="block w-full bg-white text-primary border-2 border-primary px-4 py-3 rounded-full font-bold hover:bg-primary hover:text-white transition-colors">💬 Agendar</a>
          </div>
          <div class="p-8 bg-primary rounded-2xl border border-primary text-white transform md:-translate-y-4 shadow-xl relative">
            <div class="absolute top-0 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-secondary text-white px-4 py-1 rounded-full text-sm font-bold">Ideal para Crises</div>
            <h3 class="font-bold text-xl mb-2 mt-2">Pacote 4 Sessões</h3>
            <div class="text-3xl font-bold my-4">R$ 700</div>
            <a href="https://wa.me/5511983134656?text=Olá,%20quero%20agendar%204%20sessões%20para%20dor%20ciática." class="block w-full bg-secondary text-white px-4 py-3 rounded-full font-bold hover:bg-white hover:text-secondary transition-colors">✅ Garantir Pacote Agora</a>
          </div>
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-200">
            <h3 class="font-bold text-xl text-gray-800 mb-2">Pacote 10 Sessões</h3>
            <div class="text-3xl font-bold text-primary my-4">R$ 1500</div>
            <a href="https://wa.me/5511983134656?text=Olá,%20quero%20agendar%2010%20sessões%20para%20dor%20ciática." class="block w-full bg-white text-primary border-2 border-primary px-4 py-3 rounded-full font-bold hover:bg-primary hover:text-white transition-colors">✅ Tratamento Completo</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 bg-bg-light">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="font-serif text-3xl text-primary font-bold mb-8 text-center">Perguntas Frequentes</h2>
        <div class="space-y-4">
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl text-gray-800 mb-2">Acupuntura dói mais em áreas inflamadas?</h3>
            <p class="text-gray-600">Não dói. A aplicação é segura e utilizamos pontos no corpo para relaxar a dor lombar, gerando conforto no paciente sem causar dor adicional.</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl text-gray-800 mb-2">Funciona para a dor ciática crônica?</h3>
            <p class="text-gray-600">A acupuntura pode fazer parte de uma abordagem complementar para dor ciática crônica. A resposta varia de pessoa para pessoa, e um atendimento personalizado permite avaliar melhor a sua situação.</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl text-gray-800 mb-2">Quantas sessões são necessárias para voltar a andar?</h3>
            <p class="text-gray-600">Normalmente o alívio das dores intensas surge nas primeiras sessões, sendo recomendado os pacotes de 4 a 10 sessões para garantir a estabilidade do quadro sem recidivas.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="py-20 bg-white text-center">
      <div class="container mx-auto px-4">
        <h2 class="font-serif text-4xl text-primary font-bold mb-6">Livre-se da dor que te paralisa agora!</h2>
        <a href="https://wa.me/5511983134656?text=Olá,%20gostaria%20de%20agendar%20minha%20avaliação%20para%20dor%20ciática." class="bg-secondary text-white px-10 py-5 rounded-full font-bold text-xl shadow-lg hover:shadow-xl transition-all inline-block animate-pulse-slow mt-4">
          💬 Agendar com a Dra. Valda
        </a>
      </div>
    </section>

    <footer class="bg-gray-800 text-white py-12 text-center text-sm border-t border-gray-700">
      <div class="container mx-auto px-4">
        <p class="font-bold text-lg mb-2 font-serif tracking-wide">Clínica Valda Acupuntura</p>
        <p class="opacity-80 mb-4 text-gray-300">R. Maquerobi, 156 - Vila da Saúde, São Paulo - SP</p>
        <p class="mb-6"><a href="tel:+5511983134656" class="hover:text-secondary transition-colors font-bold text-lg">(11) 98313-4656</a></p>
        <p class="opacity-50 text-xs">&copy; 2026 Valda Acupuntura. Todos os direitos reservados.</p>
      </div>
    </footer>
  </main>
</Layout>

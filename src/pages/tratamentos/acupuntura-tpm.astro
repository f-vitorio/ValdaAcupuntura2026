---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { Image, getImage } from 'astro:assets';
import heroImgSource from '../../assets/hero-premium.webp';
import valdaImg from '../../assets/valda-real.webp';

const heroImgOptimized = await getImage({
  src: heroImgSource, 
  format: 'avif',
  width: 800,
});
---

<Layout
  title="Acupuntura para TPM em São Paulo | Alívio Natural | Valda Acupuntura"
  description="Acupuntura para TPM em São Paulo. Tratamento natural para cólicas, irritabilidade e inchaço. Clínica na Vila da Saúde, Zona Sul. Agende avaliação com a Dra. Valda!"
  canonicalUrl="https://valdaacupuntura.com.br/tratamentos/acupuntura-tpm/"
  heroPreloadUrl={heroImgOptimized.src}>

  <main>
  <Header />

  <!-- FAQ JSON-LD Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Acupuntura ajuda no TPM?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sim. A acupuntura pode atuar na regulação do ciclo hormonal feminino, auxiliando no alívio de sintomas como cólicas intensas, irritabilidade, inchaço e alterações de humor. Cada pessoa responde de forma diferente, e o tratamento é personalizado."
        }
      },
      {
        "@type": "Question",
        "name": "Quantas sessões são necessárias para TPM?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "O protocolo varia conforme a intensidade dos sintomas. Geralmente, os pacotes de 4 ou 10 sessões trazem melhora significativa. O ideal é iniciar o tratamento alguns dias antes do início da menstruação."
        }
      },
      {
        "@type": "Question",
        "name": "A acupuntura dói?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Não. As agulhas são ultrafinas (0,20 a 0,25mm) e a sensação é leve — muitas pacientes relaxam profundamente durante a sessão. A técnica é praticamente indolor."
        }
      }
    ]
  })} />

    <!-- HERO -->
    <section class="relative py-20 md:py-32 text-center overflow-hidden">
      <img src={heroImgOptimized.src} alt="Acupuntura para TPM em São Paulo" class="absolute inset-0 w-full h-full object-cover object-center z-0" fetchpriority="high" loading="eager" decoding="async" width={1920} height={1080} />
      <div class="absolute inset-0 bg-gradient-to-b from-[#e8f5e9]/95 to-white/90 z-0"></div>
      
      <div class="container mx-auto px-4 max-w-4xl relative z-10">
        <span class="inline-flex items-center gap-2 bg-[#e6fffa] text-[#047857] px-5 py-2.5 rounded-full font-semibold text-sm mb-6 border border-[#b7eb8f] shadow-sm animate-fade-in mx-auto">
          Dra. Valda Fernandes • 20 Anos de Experiência
        </span>
        <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-primary leading-tight mb-6 font-bold">
          Acupuntura para TPM em São Paulo
        </h1>
        <p class="text-xl text-gray-700 mb-8 max-w-3xl mx-auto leading-relaxed">
          Sofrendo com cólicas intensas, irritabilidade e inchaço pré-menstrual? A <strong class="text-primary">acupuntura para TPM</strong> pode ajudar a regular seu ciclo e aliviar os sintomas de forma natural. Atendimento humanizado na Vila da Saúde, Zona Sul.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
          <a href="https://wa.me/5511983134656?text=Ol%C3%A1,%20busco%20tratamento%20para%20TPM.%20Gostaria%20de%20agendar%20avalia%C3%A7%C3%A3o.&utm_source=site&utm_medium=tpm_hero&utm_campaign=whatsapp_agendamento" class="bg-secondary text-white px-8 py-4 rounded-full font-bold text-lg shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all inline-flex items-center gap-3 w-full sm:w-auto justify-center" target="_blank" rel="noopener" aria-label="Agendar avaliação de TPM pelo WhatsApp">
            💬 Agendar com a Dra. Valda
          </a>
          <a href="tel:+5511983134656" class="bg-white text-primary border-2 border-primary px-8 py-4 rounded-full font-bold text-lg shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all inline-flex items-center gap-3 w-full sm:w-auto justify-center" aria-label="Ligar para a clínica">
            📞 Ligar Agora
          </a>
        </div>
      </div>
    </section>

    <!-- DOR DO PACIENTE -->
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4 max-w-4xl text-center">
        <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-6">O impacto da TPM no seu dia a dia</h2>
        <p class="text-lg text-gray-600 leading-relaxed mb-8">
          A TPM pode transformar dias tranquilos em momentos de dor, desconforto emocional e limitação física. Cólicas intensas, mudanças de humor, inchaço, sensibilidade mamária e fadiga prejudicam seu trabalho, relacionamentos e qualidade de vida. Muitas mulheres acabam dependendo de analgésicos e anti-inflamatórios que apenas mascaram os sintomas, sem tratar a causa.
        </p>
      </div>
    </section>

    <!-- SOLUÇÃO (ACUPUNTURA) -->
    <section class="py-16 bg-bg-light">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-4">Como a acupuntura ajuda no TPM</h2>
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            A acupuntura atua na regulação do sistema hormonal feminino, estimulando pontos específicos que ajudam a equilibrar o ciclo menstrual. A técnica promove a liberação de endorfinas, reduz a inflamação e regula o sistema nervoso, aliviando cólicas, irritabilidade e inchaço de forma natural.
          </p>
          <p class="text-lg text-gray-600 leading-relaxed">
            Estudos publicados no <em>Journal of Acupuncture and Meridian Studies</em> demonstram que a acupuntura pode reduzir significativamente a intensidade dos sintomas de TPM, incluindo dor abdominal, alterações de humor e fadiga. A OMS reconhece a acupuntura como abordagem eficaz para quadros ginecológicos.
          </p>
        </div>
      </div>
    </section>

    <!-- BENEFÍCIOS -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="grid md:grid-cols-2 gap-8">
          <div class="p-6 bg-gray-50 rounded-xl">
            <h3 class="font-bold text-xl text-primary mb-3">Redução de Cólicas</h3>
            <p class="text-gray-600">Alívio significativo das cólicas menstruais, diminuindo a necessidade de analgésicos e anti-inflamatórios.</p>
          </div>
          <div class="p-6 bg-gray-50 rounded-xl">
            <h3 class="font-bold text-xl text-primary mb-3">Equilíbrio Emocional</h3>
            <p class="text-gray-600">Regulação das mudanças de humor, irritabilidade e ansiedade que acompanham a TPM.</p>
          </div>
          <div class="p-6 bg-gray-50 rounded-xl">
            <h3 class="font-bold text-xl text-primary mb-3">Redução de Inchaço</h3>
            <p class="text-gray-600">Estímulo à circulação e à drenagem linfática, auxiliando na redução do inchaço pré-menstrual.</p>
          </div>
          <div class="p-6 bg-gray-50 rounded-xl">
            <h3 class="font-bold text-xl text-primary mb-3">Tratamento Natural</h3>
            <p class="text-gray-600">Abordagem sem efeitos colaterais, complementar ou alternativa a medicamentos hormonais.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- PROVA SOCIAL & AUTORIDADE -->
    <section class="py-16 bg-primary text-white">
      <div class="container mx-auto px-4 max-w-6xl flex flex-col md:flex-row items-center gap-12">
        <div class="flex-1 text-left">
          <h2 class="font-serif text-3xl md:text-4xl font-bold mb-6">Dra. Valda Fernandes</h2>
          <p class="text-lg mb-4 text-white/90 font-medium">
            Especialista em Ginecologia e Acupuntura
          </p>
          <p class="text-lg mb-4 text-white/90">
            Com 20 anos de experiência clínica, a Dra. Valda é especialista em Eletroacupuntura e atendeu milhares de pacientes com quadros de TPM, cólicas menstruais e desequilíbrios hormonais. Formada pela UNIP com pós-graduação em Medicina Tradicional Chinesa.
          </p>
          <p class="text-lg mb-4 text-white/90">
            O atendimento é 100% individual, sem pressa, em um ambiente acolhedor na Vila da Saúde. Cada sessão é cuidadosamente planejada para atender às suas necessidades específicas.
          </p>
          <div class="mb-8 p-6 bg-white/5 rounded-xl border border-white/10">
            <p class="text-lg text-white/90 italic">
              "A TPM me deixava incapacitada por dias. Com a acupuntura da Dra. Valda, as cólicas diminuíram muito e consigo levar minha vida normalmente durante o período menstrual." – Mariana S.
            </p>
          </div>
          <div class="bg-white/10 p-6 rounded-2xl border border-white/20">
            <h3 class="font-bold text-xl mb-2 text-green-300">Localização Privilegiada</h3>
            <p>Vila da Saúde</p>
            <p>Zona Sul de São Paulo (SP)</p>
            <p>Próximo ao Metrô Praça da Árvore</p>
          </div>
        </div>
        <div class="flex-1 max-w-md mx-auto">
          <Image src={valdaImg} alt="Dra. Valda Fernandes" width={500} height={500} class="rounded-2xl shadow-xl border-4 border-white/10" />
        </div>
      </div>
    </section>

    <!-- PREÇOS -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 max-w-5xl text-center">
        <h2 class="font-serif text-3xl text-primary font-bold mb-10">Valores dos Tratamentos</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-200">
            <h3 class="font-bold text-xl text-gray-800 mb-2">Primeira Consulta</h3>
            <div class="text-3xl font-bold text-primary my-4">R$ 250</div>
            <a href="https://wa.me/5511983134656?text=Ol%C3%A1,%20quero%20agendar%20minha%20primeira%20consulta%20para%20TPM.&utm_source=site&utm_medium=tpm_precos_avaliacao&utm_campaign=whatsapp_agendamento" class="block w-full bg-white text-primary border-2 border-primary px-4 py-3 rounded-full font-bold hover:bg-primary hover:text-white transition-colors" target="_blank" rel="noopener" aria-label="Agendar primeira consulta para TPM">💬 Agendar</a>
          </div>
          <div class="p-8 bg-primary rounded-2xl border border-primary text-white transform md:-translate-y-4 shadow-xl relative">
            <div class="absolute top-0 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-secondary text-white px-4 py-1 rounded-full text-sm font-bold">Recomendado</div>
            <h3 class="font-bold text-xl mb-2 mt-2">Pacote 4 Sessões</h3>
            <div class="text-3xl font-bold my-4">R$ 700</div>
            <a href="https://wa.me/5511983134656?text=Ol%C3%A1,%20quero%20agendar%204%20sess%C3%B5es%20para%20TPM.&utm_source=site&utm_medium=tpm_precos_4sessoes&utm_campaign=whatsapp_agendamento" class="block w-full bg-secondary text-white px-4 py-3 rounded-full font-bold hover:bg-white hover:text-secondary transition-colors" target="_blank" rel="noopener" aria-label="Garantir pacote de 4 sessões para TPM">✅ Garantir Pacote Agora</a>
          </div>
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-200">
            <h3 class="font-bold text-xl text-gray-800 mb-2">Pacote 10 Sessões</h3>
            <div class="text-3xl font-bold text-primary my-4">R$ 1500</div>
            <a href="https://wa.me/5511983134656?text=Ol%C3%A1,%20quero%20agendar%2010%20sess%C3%B5es%20para%20TPM.&utm_source=site&utm_medium=tpm_precos_10sessoes&utm_campaign=whatsapp_agendamento" class="block w-full bg-white text-primary border-2 border-primary px-4 py-3 rounded-full font-bold hover:bg-primary hover:text-white transition-colors" target="_blank" rel="noopener" aria-label="Agendar tratamento completo de 10 sessões para TPM">✅ Tratamento Completo</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 bg-bg-light">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="font-serif text-3xl text-primary font-bold mb-8 text-center">Perguntas Frequentes</h2>
        <div class="space-y-4">
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl text-gray-800 mb-2">Acupuntura ajuda no TPM?</h3>
            <p class="text-gray-600">Sim. A acupuntura pode atuar na regulação do ciclo hormonal feminino, auxiliando no alívio de sintomas como cólicas intensas, irritabilidade, inchaço e alterações de humor. Cada pessoa responde de forma diferente, e o tratamento é personalizado.</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl text-gray-800 mb-2">Quantas sessões são necessárias para TPM?</h3>
            <p class="text-gray-600">O protocolo varia conforme a intensidade dos sintomas. Geralmente, os pacotes de 4 ou 10 sessões trazem melhora significativa. O ideal é iniciar o tratamento alguns dias antes do início da menstruação.</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl text-gray-800 mb-2">A acupuntura dói?</h3>
            <p class="text-gray-600">Não. As agulhas são ultrafinas (0,20 a 0,25mm) e a sensação é leve — muitas pacientes relaxam profundamente durante a sessão. A técnica é praticamente indolor.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="py-20 bg-white text-center">
      <div class="container mx-auto px-4">
        <h2 class="font-serif text-4xl text-primary font-bold mb-6">Chega de sofrer com TPM. Agende sua avaliação</h2>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-4">
          <a href="https://wa.me/5511983134656?text=Ol%C3%A1,%20gostaria%20de%20agendar%20minha%20avalia%C3%A7%C3%A3o%20para%20TPM.&utm_source=site&utm_medium=tpm_final_cta&utm_campaign=whatsapp_agendamento" class="bg-secondary text-white px-10 py-5 rounded-full font-bold text-xl shadow-lg hover:shadow-xl transition-all inline-flex items-center gap-3 animate-pulse-slow" target="_blank" rel="noopener" aria-label="Agendar avaliação final para TPM pelo WhatsApp">
            💬 Agendar com a Dra. Valda
          </a>
          <a href="tel:+5511983134656" class="bg-white text-primary border-2 border-primary px-10 py-5 rounded-full font-bold text-xl shadow-lg hover:shadow-xl transition-all inline-flex items-center gap-3" aria-label="Ligar para a clínica">
            📞 Ligar Agora
          </a>
        </div>
      </div>
    </section>

    <footer class="bg-gray-800 text-white py-12 text-center text-sm border-t border-gray-700">
      <div class="container mx-auto px-4">
        <p class="font-bold text-lg mb-2 font-serif tracking-wide">Clínica Valda Acupuntura</p>
        <p class="opacity-80 mb-4 text-gray-300">R. Maquerobi, 156 - Vila da Saúde, São Paulo - SP</p>
        <p class="mb-6"><a href="tel:+5511983134656" class="hover:text-secondary transition-colors font-bold text-lg">(11) 98313-4656</a></p>
        <p class="opacity-50 text-xs">&copy; 2026 Valda Acupuntura. Todos os direitos reservados.</p>
      </div>
    </footer>
  </main>
</Layout>

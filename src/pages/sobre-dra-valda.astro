---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import valdaImg from '../assets/valda-real.webp';
import heroImg from '../assets/hero-premium.webp';
import { Image } from 'astro:assets';

const pageTitle = "Sobre a Dra. Valda Fernandes | Acupunturista em São Paulo";
const pageDescription = "Conheça a trajetória da Dra. Valda Fernandes, acupunturista com 20 anos de experiência na Vila da Saúde, zona sul de São Paulo. Especialista em Eletroacupuntura e Medicina Tradicional Chinesa.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  heroPreloadUrl={heroImg.src}
  canonicalUrl="https://valdaacupuntura.com.br/sobre-dra-valda/"
>

<!-- Schema Person -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Dra. Valda Fernandes",
  "jobTitle": "Acupunturista",
  "description": "Acupunturista com 20 anos de experiência clínica, especialista em Eletroacupuntura e Medicina Tradicional Chinesa.",
  "url": "https://valdaacupuntura.com.br/sobre-dra-valda/",
  "image": "https://valdaacupuntura.com.br/valda.webp",
  "worksFor": {
    "@type": "MedicalClinic",
    "@id": "https://valdaacupuntura.com.br/#organization",
    "name": "Valda Acupuntura"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "R. Maquerobi, 156",
    "addressLocality": "São Paulo",
    "addressRegion": "SP",
    "addressCountry": "BR"
  },
  "alumniOf": {
    "@type": "EducationalOrganization",
    "name": "UNIP - Universidade Paulista"
  },
  "knowsAbout": ["Acupuntura", "Eletroacupuntura", "Medicina Tradicional Chinesa", "Dor Crônica", "Ansiedade", "Insônia", "Enxaqueca"]
})} />

  <!-- HERO -->
  <section class="relative py-20 md:py-32 text-center overflow-hidden">
    <Image 
      src={heroImg} 
      alt="Dra. Valda Fernandes, acupunturista em São Paulo" 
      class="absolute inset-0 w-full h-full object-cover object-center z-0"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      width={1920}
      height={1080}
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[#e8f5e9]/95 to-white/90 z-0"></div>
    
    <div class="container mx-auto px-4 max-w-4xl relative z-10">
      <span class="inline-flex items-center gap-2 bg-[#e6fffa] text-[#047857] px-5 py-2.5 rounded-full font-semibold text-sm mb-6 border border-[#b7eb8f] shadow-sm animate-fade-in mx-auto">
        Acupunturista • Vila da Saúde, São Paulo
      </span>
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-primary leading-tight mb-6 font-bold">
        Sobre a Dra. Valda Fernandes
      </h1>
      <p class="text-xl text-gray-700 mb-8 max-w-3xl mx-auto leading-relaxed">
        Conheça a trajetória de quem dedica 20 anos da sua carreira ao cuidado integral dos pacientes através da acupuntura.
      </p>
    </div>
  </section>

  <!-- BIO -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 max-w-6xl flex flex-col md:flex-row items-center gap-12">
      <div class="flex-1 max-w-md mx-auto">
        <Image 
          src={valdaImg} 
          alt="Dra. Valda Fernandes, acupunturista" 
          width={500} 
          height={500} 
          class="rounded-2xl shadow-2xl w-full h-auto object-cover aspect-square border-4 border-white/10"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="flex-1 text-left">
        <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-6">Quem é a Dra. Valda</h2>
        <p class="text-lg text-gray-600 leading-relaxed mb-4">
          A Dra. Valda Fernandes é acupunturista com <strong class="text-primary">20 anos de experiência clínica</strong>, atuando na Vila da Saúde, zona sul de São Paulo. Formada pela <strong class="text-primary">UNIP (Universidade Paulista)</strong>, ela complementou sua formação com pós-graduação em <strong class="text-primary">Medicina Tradicional Chinesa</strong>.
        </p>
        <p class="text-lg text-gray-600 leading-relaxed mb-4">
          Ao longo de duas décadas de prática, atendeu milhares de pacientes com quadros de dor crônica, ansiedade, insônia e enxaqueca, sempre com foco em protocolos individualizados e baseados em evidências.
        </p>
        <p class="text-lg text-gray-600 leading-relaxed mb-6">
          Sua abordagem combina a precisão da <strong class="text-primary">Eletroacupuntura</strong> com a sabedoria da Medicina Tradicional Chinesa, garantindo um tratamento seguro, dedicado e eficaz.
        </p>
        <div class="flex flex-wrap gap-3">
          <span class="bg-primary/10 text-primary px-4 py-2 rounded-full text-sm font-bold">Eletroacupuntura</span>
          <span class="bg-primary/10 text-primary px-4 py-2 rounded-full text-sm font-bold">Medicina Tradicional Chinesa</span>
          <span class="bg-primary/10 text-primary px-4 py-2 rounded-full text-sm font-bold">Dor Crônica</span>
          <span class="bg-primary/10 text-primary px-4 py-2 rounded-full text-sm font-bold">Ansiedade</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TRAJETÓRIA -->
  <section class="py-16 md:py-24 bg-bg-light">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-16">
        <span class="inline-block bg-primary/10 text-primary px-4 py-1.5 rounded-full font-semibold text-sm mb-4">Trajetória</span>
        <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-4">Formação e Especializações</h2>
      </div>

      <div class="space-y-8">
        <div class="flex gap-6 items-start">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0 shadow-md">1</div>
          <div>
            <h3 class="font-bold text-xl text-gray-800 mb-2">Graduação em Biomedicina — UNIP</h3>
            <p class="text-gray-600">Formação pela Universidade Paulista, com base sólida em ciências da saúde e pesquisa clínica.</p>
          </div>
        </div>
        <div class="flex gap-6 items-start">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0 shadow-md">2</div>
          <div>
            <h3 class="font-bold text-xl text-gray-800 mb-2">Pós-graduação em Medicina Tradicional Chinesa</h3>
            <p class="text-gray-600">Especialização em acupuncture, moxabustão, fitoterapia chinesa e eletroacupuntura, com foco em protocolos clínicos.</p>
          </div>
        </div>
        <div class="flex gap-6 items-start">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0 shadow-md">3</div>
          <div>
            <h3 class="font-bold text-xl text-gray-800 mb-2">20 anos de prática clínica</h3>
            <p class="text-gray-600">Mais de duas décadas atendendo pacientes com dor crônica, ansiedade, insônia e enxaqueca na zona sul de São Paulo.</p>
          </div>
        </div>
        <div class="flex gap-6 items-start">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0 shadow-md">4</div>
          <div>
            <h3 class="font-bold text-xl text-gray-800 mb-2">Especialização em Eletroacupuntura</h3>
            <p class="text-gray-600">Domínio de técnicas avançadas de eletroacupuntura para potencializar resultados em quadros de dor e desequilíbrios do sistema nervoso.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DIFERENCIAIS -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="text-center mb-16">
        <span class="inline-block bg-primary/10 text-primary px-4 py-1.5 rounded-full font-semibold text-sm mb-4">Por que escolher</span>
        <h2 class="font-serif text-3xl md:text-4xl text-primary font-bold mb-4">Diferenciais do atendimento</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="p-6 bg-gray-50 rounded-xl border border-gray-100">
          <div class="text-3xl mb-4">🎯</div>
          <h3 class="font-bold text-xl text-primary mb-3">Atendimento 100% Individual</h3>
          <p class="text-gray-600">Sessões exclusivas, sem pressa, em um ambiente acolhedor e reservado para você.</p>
        </div>
        <div class="p-6 bg-gray-50 rounded-xl border border-gray-100">
          <div class="text-3xl mb-4">📋</div>
          <h3 class="font-bold text-xl text-primary mb-3">Protocolo Personalizado</h3>
          <p class="text-gray-600">Cada tratamento é planejado com base na sua avaliação inicial e ajustado a cada sessão.</p>
        </div>
        <div class="p-6 bg-gray-50 rounded-xl border border-gray-100">
          <div class="text-3xl mb-4">⚡</div>
          <h3 class="font-bold text-xl text-primary mb-3">Eletroacupuntura Avançada</h3>
          <p class="text-gray-600">Técnicas que potencializam os resultados, especialmente em quadros de dor crônica.</p>
        </div>
        <div class="p-6 bg-gray-50 rounded-xl border border-gray-100">
          <div class="text-3xl mb-4">📍</div>
          <h3 class="font-bold text-xl text-primary mb-3">Localização Privilegiada</h3>
          <p class="text-gray-600">Vila da Saúde, zona sul de São Paulo. Próximo ao Metrô Praça da Árvore.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-primary text-white text-center">
    <div class="container mx-auto px-4 max-w-3xl">
      <h2 class="font-serif text-3xl md:text-4xl font-bold mb-6">Pronto para conhecer a Dra. Valda?</h2>
      <p class="text-xl text-white/90 mb-8">Agende sua avaliação e descubra como a acupuntura pode transformar sua qualidade de vida.</p>
      <a href="https://wa.me/5511983134656?text=Ol%C3%A1,%20gostaria%20de%20agendar%20uma%20avalia%C3%A7%C3%A3o%20com%20a%20Dra.%20Valda.&utm_source=site&utm_medium=sobre_dra_valda&utm_campaign=whatsapp_agendamento" class="inline-flex items-center justify-center gap-3 bg-secondary text-white px-8 py-4 rounded-full font-bold shadow-lg hover:bg-green-600 transition-all text-lg" target="_blank" rel="noopener" aria-label="Agendar avaliação com Dra. Valda pelo WhatsApp">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.47-.297z" /></svg>
        Agendar avaliação com a Dra. Valda
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-900 text-white py-12">
    <div class="container mx-auto px-4 max-w-5xl text-center">
      <p class="text-gray-400 mb-2">&copy; 2026 Valda Acupuntura. Todos os direitos reservados.</p>
      <p class="text-gray-500 text-sm">R. Maquerobi, 156 - Vila da Saúde, São Paulo - SP | (11) 98313-4656</p>
    </div>
  </footer>
</Layout>

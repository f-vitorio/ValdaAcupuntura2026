---
import { Image } from 'astro:assets';
import logoImg from '../assets/logo-valda.webp';
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm shadow-sm border-b border-gray-100 py-3">
	<div class="container mx-auto px-4 flex justify-between items-center max-w-6xl">
		<a href="/" class="flex items-center gap-3 no-underline group">
			<Image src={logoImg} alt="Logo Valda Acupuntura" width={48} height={48} class="rounded-full shadow-sm group-hover:scale-105 transition-transform w-10 h-10 md:w-12 md:h-12" loading="eager" />
			<span class="font-serif font-bold text-primary text-xl tracking-tight">Valda Acupuntura</span>
		</a>

		<nav class="hidden md:flex items-center gap-8">
			<a href="/#servicos" class="font-medium text-gray-700 hover:text-primary transition-colors text-sm">Serviços</a>
			<div class="relative group">
				<a href="/acupuntura-sao-paulo-tratamentos/" class="font-medium text-gray-700 hover:text-primary transition-colors text-sm flex items-center gap-1">
					Tratamentos
					<svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
				</a>
				<div class="absolute left-1/2 -translate-x-1/2 top-[90%] w-64 bg-white rounded-xl shadow-xl border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50 transform translate-y-2 group-hover:translate-y-0">
					<div class="py-2">
						<a href="/tratamentos/acupuntura-ansiedade/" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-primary/5 hover:text-primary font-medium transition-colors">Acupuntura para Ansiedade</a>
						<a href="/tratamentos/acupuntura-estresse/" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-primary/5 hover:text-primary font-medium transition-colors">Acupuntura para Estresse</a>
						<a href="/tratamentos/acupuntura-insonia/" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-primary/5 hover:text-primary font-medium transition-colors">Acupuntura para Insônia</a>
						<a href="/tratamentos/acupuntura-dor-ciatica/" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-primary/5 hover:text-primary font-medium transition-colors">Dor Ciática e Lombar</a>
						<a href="/tratamentos/acupuntura-enxaqueca/" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-primary/5 hover:text-primary font-medium transition-colors">Acupuntura para Enxaqueca</a>
						<a href="/tratamentos/acupuntura-tpm/" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-primary/5 hover:text-primary font-medium transition-colors">Acupuntura para TPM</a>
						<a href="/tratamentos/acupuntura-fibromialgia/" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-primary/5 hover:text-primary font-medium transition-colors">Acupuntura para Fibromialgia</a>
						<a href="/tratamentos/acupuntura-tendinite/" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-primary/5 hover:text-primary font-medium transition-colors">Tendinite e LER/DORT</a>
						<a href="/tratamentos/acupuntura-bruxismo/" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-primary/5 hover:text-primary font-medium transition-colors">Acupuntura para Bruxismo</a>
						<a href="/tratamentos/acupuntura-problemas-digestivos/" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-primary/5 hover:text-primary font-medium transition-colors">Problemas Digestivos</a>
						<div class="border-t border-gray-100 my-1"></div>
						<a href="/acupuntura-sao-paulo-tratamentos/" class="block px-4 py-2 text-xs text-gray-500 hover:text-primary font-bold uppercase tracking-wider text-center">Ver todos</a>
					</div>
				</div>
			</div>
			<a href="/#especialista" class="font-medium text-gray-700 hover:text-primary transition-colors text-sm">Especialista</a>
			<a href="/sobre-dra-valda/" class="font-medium text-gray-700 hover:text-primary transition-colors text-sm">Sobre</a>
			<a href="/precos/" class="font-medium text-gray-700 hover:text-primary transition-colors text-sm">Preços</a>
			<a href="/blog/" class="font-medium text-gray-700 hover:text-primary transition-colors text-sm">Blog</a>
			<a href="https://maps.google.com/?q=R.+Maquerobi,+156+-+Vila+da+Saúde,+São+Paulo,+SP" target="_blank" rel="noopener" class="font-medium text-secondary hover:text-green-600 transition-colors text-sm flex items-center gap-1">
				📍 Como Chegar
			</a>
		</nav>

		<div class="md:hidden flex items-center gap-3">
			<a href="https://wa.me/5511983134656?text=Ol%C3%A1!%20Vim%20pelo%20site%20e%20gostaria%20de%20agendar%20uma%20consulta.&utm_source=site&utm_medium=header_mobile&utm_campaign=whatsapp_cta" class="bg-secondary text-white px-4 py-2 rounded-full text-sm font-bold shadow-md hover:bg-green-600 transition-all" target="_blank" rel="noopener">
				WhatsApp
			</a>
			<a href="tel:+5511983134656" class="bg-green-600 text-white px-4 py-2 rounded-full text-sm font-bold shadow-md hover:bg-green-700 transition-all" aria-label="Ligar para a clínica">
				Ligar
			</a>
			<a href="https://maps.google.com/?q=R.+Maquerobi,+156+-+Vila+da+Saúde,+São+Paulo,+SP" target="_blank" rel="noopener" class="bg-white text-primary border border-primary px-3 py-2 rounded-full hover:bg-primary hover:text-white transition-all shadow-sm text-sm font-bold inline-flex items-center gap-1" aria-label="Abrir Google Maps">
				📍 Mapa
			</a>
		</div>
	</div>
</header>
